@* Menú de usuario del Topbar — mismo Dropdown reutilizable que Notificaciones. *@
@inject UserManager<ApplicationUser> UserManager

<AuthorizeView>
    <Authorized Context="authContext">
        <Dropdown>
            <Trigger>
                <button type="button" class="flex items-center gap-2 rounded-sm px-2 py-1.5 hover:bg-card-elevated">
                    <span class="h-7 w-7 rounded-full bg-primary-600 text-white text-xs font-semibold flex items-center justify-center shrink-0">
                        @Inicial(nombreMostrado)
                    </span>
                    <span class="hidden sm:block text-sm text-body max-w-[10rem] truncate">@nombreMostrado</span>
                    <Icon Name="chevron-down" Class="h-4 w-4 text-muted hidden sm:block" />
                </button>
            </Trigger>
            <ChildContent>
                <div class="w-48 bg-card border border-border-subtle rounded-lg shadow-elevated py-1">
                    <div class="px-3 py-2 border-b border-border-subtle">
                        <p class="text-xs text-muted">Sesión iniciada como</p>
                        <p class="text-sm font-medium text-heading truncate">@nombreMostrado</p>
                    </div>
                    <a href="Account/Manage" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-body hover:bg-card-elevated hover:text-heading">
                        <Icon Name="user" Class="h-4 w-4" />
                        Mi cuenta
                    </a>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="" />
                        <button type="submit" class="w-full flex items-center gap-2 px-3 py-2 text-sm text-body hover:bg-card-elevated hover:text-heading">
                            <Icon Name="logout" Class="h-4 w-4" />
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </ChildContent>
        </Dropdown>
    </Authorized>
    <NotAuthorized>
        <div class="flex items-center gap-3 text-sm">
            <a href="Account/Login" class="text-muted hover:text-heading">Iniciar sesión</a>
            <a href="Account/Register" class="btn btn-primary btn-sm">Registrarse</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private string? nombreMostrado;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is null) return;

        var authState = await AuthStateTask;
        var appUser = await UserManager.GetUserAsync(authState.User);
        nombreMostrado = appUser.NombreParaMostrar(authState.User.Identity?.Name);
    }

    private static string Inicial(string? nombre) =>
        string.IsNullOrEmpty(nombre) ? "?" : nombre.Trim()[0].ToString().ToUpperInvariant();
}
