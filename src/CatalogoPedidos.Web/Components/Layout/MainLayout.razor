@inherits LayoutComponentBase

<div class="flex h-screen overflow-hidden bg-gray-50">
    <Sidebar Collapsed="sidebarCollapsed" CollapsedChanged="c => sidebarCollapsed = c"
             MobileOpen="sidebarMobileOpen" MobileOpenChanged="o => sidebarMobileOpen = o" />

    <div class="flex-1 flex flex-col min-w-0">
        <Topbar OnToggleSidebar="() => sidebarMobileOpen = !sidebarMobileOpen" />

        <main class="flex-1 overflow-y-auto">
            <div class="max-w-6xl mx-auto p-6">
                @Body
            </div>
        </main>
    </div>
</div>

<div id="blazor-error-ui" class="hidden fixed inset-x-0 bottom-0 z-50 bg-danger-700 text-white text-sm px-4 py-3" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="underline ml-2">Recargar</a>
    <span class="dismiss ml-2 cursor-pointer">🗙</span>
</div>

@code {
    private bool sidebarCollapsed;
    private bool sidebarMobileOpen;
}
