@* Navegación lateral — único punto de verdad de la estructura de módulos de la app. *@
<aside class="@($"bg-gray-900 text-white flex flex-col shrink-0 transition-all duration-200 {(Collapsed ? "w-16" : "w-64")} " +
                $"fixed inset-y-0 left-0 z-40 lg:static lg:z-auto {(MobileOpen ? "translate-x-0" : "-translate-x-full lg:translate-x-0")}")">
    <div class="h-14 flex items-center gap-2 px-4 border-b border-white/10 shrink-0">
        <div class="h-7 w-7 rounded-md bg-primary-600 flex items-center justify-center font-bold text-sm shrink-0">C</div>
        @if (!Collapsed)
        {
            <span class="font-semibold truncate">CatalogoPedidos</span>
        }
    </div>

    <nav class="flex-1 overflow-y-auto py-4 px-2 space-y-1">
        <NavLink href="/catalogo" class="sidebar-link" ActiveClass="sidebar-link-active" Match="NavLinkMatch.All">
            <Icon Name="cube" Class="h-5 w-5 shrink-0" />
            @if (!Collapsed) { <span>Catálogo</span> }
        </NavLink>

        <AuthorizeView>
            <Authorized>
                <NavLink href="/solicitudes/mis-solicitudes" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="clipboard-list" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Mis solicitudes</span> }
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Gestor">
            <Authorized>
                @if (!Collapsed)
                {
                    <p class="px-3 pt-4 pb-1 text-xs font-semibold text-gray-500 uppercase tracking-wide">Gestión</p>
                }
                else
                {
                    <div class="border-t border-white/10 my-2"></div>
                }

                <NavLink href="/solicitudes/bandeja" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="inbox" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Bandeja de solicitudes</span> }
                </NavLink>
                <NavLink href="/solicitudes/administrar" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="adjustments" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Administrar pedidos</span> }
                </NavLink>
                <NavLink href="/solicitudes/historial-envios" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="clock" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Historial de envíos</span> }
                </NavLink>
                <NavLink href="/catalogo/nuevo" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="plus" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Nuevo producto</span> }
                </NavLink>
                <NavLink href="/catalogo/importar" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="download" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Importar productos</span> }
                </NavLink>
                <NavLink href="/proveedores" class="sidebar-link" ActiveClass="sidebar-link-active">
                    <Icon Name="truck" Class="h-5 w-5 shrink-0" />
                    @if (!Collapsed) { <span>Proveedores</span> }
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <button type="button" class="hidden lg:flex items-center gap-2 px-4 py-3 border-t border-white/10 text-gray-400 hover:text-white text-sm" @onclick="() => CollapsedChanged.InvokeAsync(!Collapsed)">
        <Icon Name="@(Collapsed ? "chevron-right" : "chevron-left")" Class="h-4 w-4" />
        @if (!Collapsed) { <span>Colapsar</span> }
    </button>
</aside>

@if (MobileOpen)
{
    <button type="button" class="fixed inset-0 z-30 bg-gray-900/50 lg:hidden" @onclick="() => MobileOpenChanged.InvokeAsync(false)" aria-label="Cerrar menú"></button>
}

@code {
    [Parameter] public bool Collapsed { get; set; }
    [Parameter] public EventCallback<bool> CollapsedChanged { get; set; }
    [Parameter] public bool MobileOpen { get; set; }
    [Parameter] public EventCallback<bool> MobileOpenChanged { get; set; }
}
