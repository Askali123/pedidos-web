@implements IDisposable
@using System.Security.Claims
@inject INotificacionService NotificacionService
@inject INotificacionBroadcaster Broadcaster
@inject NavigationManager Navigation

<AuthorizeView Context="authContext">
    <Authorized>
        <Dropdown @ref="dropdown">
            <Trigger>
                <button type="button" class="relative h-9 w-9 flex items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-700" title="Notificaciones" aria-label="Notificaciones">
                    <Icon Name="bell" Class="h-5 w-5" />
                    @if (noLeidas > 0)
                    {
                        <span class="absolute top-1 right-1 h-4 min-w-4 px-0.5 rounded-full bg-danger-600 text-white text-[10px] leading-4 text-center">@(noLeidas > 9 ? "9+" : noLeidas.ToString())</span>
                    }
                </button>
            </Trigger>
            <ChildContent>
                <div class="w-80 max-h-96 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
                        <h3>Notificaciones</h3>
                        @if (noLeidas > 0)
                        {
                            <button type="button" class="text-xs text-primary-700 hover:underline" @onclick="MarcarTodasLeidas">Marcar todas como leídas</button>
                        }
                    </div>

                    @if (notificaciones.Count == 0)
                    {
                        <p class="text-sm text-gray-500 px-4 py-6 text-center">No tienes notificaciones.</p>
                    }
                    else
                    {
                        @foreach (var n in notificaciones)
                        {
                            <button type="button" class="@("w-full text-left px-4 py-3 border-b border-gray-50 last:border-0 hover:bg-gray-50 " + (n.Leida ? "" : "bg-primary-50/60"))" @onclick="() => Abrir(n)">
                                <p class="text-sm font-medium text-gray-900">@n.Titulo</p>
                                <p class="text-xs text-gray-500 mt-0.5">@n.Mensaje</p>
                                <p class="text-[11px] text-gray-400 mt-1">@n.FechaCreacion.ToLocalTime().ToString("dd/MM HH:mm")</p>
                            </button>
                        }
                    }
                </div>
            </ChildContent>
        </Dropdown>
    </Authorized>
</AuthorizeView>

@code {
    private Dropdown? dropdown;
    private List<Notificacion> notificaciones = new();
    private int noLeidas;
    private string? usuarioId;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            usuarioId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        if (usuarioId is not null)
        {
            await Cargar();
            Broadcaster.Recibida += OnNotificacionRecibida;
        }
    }

    private async Task Cargar()
    {
        notificaciones = await NotificacionService.ObtenerRecientesAsync(usuarioId!);
        noLeidas = await NotificacionService.ContarNoLeidasAsync(usuarioId!);
    }

    private void OnNotificacionRecibida(Notificacion n)
    {
        if (n.UsuarioDestinoId != usuarioId) return;

        InvokeAsync(() =>
        {
            notificaciones.Insert(0, n);
            noLeidas++;
            StateHasChanged();
        });
    }

    private async Task MarcarTodasLeidas()
    {
        await NotificacionService.MarcarTodasLeidasAsync(usuarioId!);
        foreach (var n in notificaciones) n.Leida = true;
        noLeidas = 0;
    }

    private async Task Abrir(Notificacion n)
    {
        if (!n.Leida)
        {
            await NotificacionService.MarcarLeidaAsync(n.Id);
            n.Leida = true;
            noLeidas = Math.Max(0, noLeidas - 1);
        }

        dropdown?.Cerrar();

        if (!string.IsNullOrEmpty(n.Url))
            Navigation.NavigateTo(n.Url);
    }

    public void Dispose()
    {
        Broadcaster.Recibida -= OnNotificacionRecibida;
    }
}
