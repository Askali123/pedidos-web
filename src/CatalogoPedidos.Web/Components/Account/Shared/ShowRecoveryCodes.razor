<Card Title="Códigos de recuperación">
    <StatusMessage Message="@StatusMessage" />
    <Alert Variant="AlertVariant.Warning">
        <p><strong>Guardá estos códigos en un lugar seguro.</strong></p>
        <p class="mt-1">Si perdés tu dispositivo y no tenés los códigos de recuperación, vas a perder el acceso a tu cuenta.</p>
    </Alert>
    <div class="grid grid-cols-2 gap-2 mt-4 font-mono text-sm">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="bg-gray-50 border border-gray-200 rounded-md px-3 py-2">@recoveryCode</code>
        }
    </div>
</Card>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
