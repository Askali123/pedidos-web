@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject SignInManager<ApplicationUser> SignInManager

<Card Title="Mi cuenta">
    <nav class="space-y-1 -mt-1">
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage" Match="NavLinkMatch.All">Perfil</NavLink>
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/Email">Email</NavLink>
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/ChangePassword">Contraseña</NavLink>
        @if (hasExternalLogins)
        {
            <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/ExternalLogins">Inicios de sesión externos</NavLink>
        }
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/TwoFactorAuthentication">Autenticación en dos pasos</NavLink>
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/Passkeys">Passkeys</NavLink>
        <NavLink class="nav-link-light" ActiveClass="nav-link-light-active" href="Account/Manage/PersonalData">Datos personales</NavLink>
    </nav>
</Card>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
