@page "/Account/RegisterConfirmation"
@attribute [AllowAnonymous]
@layout CatalogoPedidos.Web.Components.Layout.AuthLayout

@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Revisa tu correo</PageTitle>

<Card Title="Revisa tu correo">
    @if (errorMessage is not null)
    {
        <Alert Variant="AlertVariant.Danger">@errorMessage</Alert>
    }
    else
    {
        <Alert Variant="AlertVariant.Success">
            Te enviamos un correo a <strong>@Email</strong> con un enlace para confirmar tu
            cuenta. Puede tardar unos minutos en llegar — revisá también la carpeta de spam.
            Si no te llega, podés reenviarlo desde el enlace de abajo.
        </Alert>
    }
    <div class="mt-4 text-sm text-center space-x-3">
        <a href="Account/ResendEmailConfirmation" class="text-primary-300 hover:underline">Reenviar el correo</a>
        <a href="Account/Login" class="text-primary-300 hover:underline">Volver a iniciar sesión</a>
    </div>
</Card>

@code {
    private string? errorMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Email is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByEmailAsync(Email);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            errorMessage = "No encontramos ninguna cuenta con ese email.";
        }
    }
}
