@page "/Account/ForgotPasswordConfirmation"
@attribute [AllowAnonymous]
@layout CatalogoPedidos.Web.Components.Layout.AuthLayout

<PageTitle>Revisa tu correo</PageTitle>

<Card Title="Revisa tu correo">
    <Alert Variant="AlertVariant.Success">
        Si el email existe en el sistema, te enviamos un enlace para restablecer tu contraseña.
    </Alert>
    <div class="mt-4 text-sm text-center">
        <a href="Account/Login" class="text-primary-700 hover:underline">Volver a iniciar sesión</a>
    </div>
</Card>
