@page "/Account/Manage/EnableAuthenticator"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject UrlEncoder UrlEncoder
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator> Logger
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Configurar app autenticadora</PageTitle>

<div class="max-w-xl">
@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <Card Title="Configurar app autenticadora">
        <StatusMessage Message="@message" />
        <ol class="space-y-4 list-decimal list-inside text-sm text-body">
            <li>
                <span>
                    Descargá una app autenticadora como Microsoft Authenticator para
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072" class="text-primary-300 hover:underline">Android</a> y
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073" class="text-primary-300 hover:underline">iOS</a>, o
                    Google Authenticator para
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" class="text-primary-300 hover:underline">Android</a> y
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="text-primary-300 hover:underline">iOS</a>.
                </span>
            </li>
            <li>
                <p class="mb-2">Escaneá el código QR o ingresá esta clave <kbd class="px-1.5 py-0.5 rounded bg-card-elevated text-xs">@sharedKey</kbd> en tu app autenticadora. Espacios y mayúsculas no importan.</p>
                <Alert Variant="AlertVariant.Info">Aprendé a <a href="https://go.microsoft.com/fwlink/?Linkid=852423" class="underline">habilitar la generación del código QR</a>.</Alert>
                <div data-url="@authenticatorUri"></div>
            </li>
            <li>
                <p class="mb-2">
                    Una vez que hayas escaneado el código QR o ingresado la clave, tu app autenticadora te va a dar un
                    código único. Ingresalo en el cuadro de confirmación de abajo.
                </p>
                <EditForm Model="Input" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger-400 text-sm mb-2" role="alert" />
                    <FormField Label="Código de verificación" Required="true">
                        <InputText @bind-Value="Input.Code" id="Input.Code" class="form-input" autocomplete="off" placeholder="000000" />
                        <ValidationMessage For="() => Input.Code" class="text-danger-400 text-xs mt-1" />
                    </FormField>
                    <Button Type="submit" Variant="ButtonVariant.Primary" Icon="check">Verificar</Button>
                </EditForm>
            </li>
        </ol>
    </Card>
}
</div>

@code {
    private const string AuthenticatorUriFormat = "otpauth://totp/{0}:{1}?secret={2}&issuer={0}&digits=6";

    private string? message;
    private ApplicationUser? user;
    private string? sharedKey;
    private string? authenticatorUri;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Configurar app autenticadora", [("Mi cuenta", "/Account/Manage"), ("Autenticación en dos pasos", "/Account/Manage/TwoFactorAuthentication"), ("Configurar app autenticadora", null)]);

        Input ??= new();

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await LoadSharedKeyAndQrCodeUriAsync(scopedUserManager, user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var scopedUser = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (scopedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        // Strip spaces and hyphens
        var verificationCode = Input.Code.Replace(" ", string.Empty).Replace("-", string.Empty);

        var is2faTokenValid = await scopedUserManager.VerifyTwoFactorTokenAsync(
            scopedUser, scopedUserManager.Options.Tokens.AuthenticatorTokenProvider, verificationCode);

        if (!is2faTokenValid)
        {
            message = "Error: El código de verificación no es válido.";
            return;
        }

        await scopedUserManager.SetTwoFactorEnabledAsync(scopedUser, true);
        var userId = await scopedUserManager.GetUserIdAsync(scopedUser);
        Logger.LogInformation("User with ID '{UserId}' has enabled 2FA with an authenticator app.", userId);

        message = "Tu app autenticadora quedó verificada.";

        if (await scopedUserManager.CountRecoveryCodesAsync(scopedUser) == 0)
        {
            recoveryCodes = await scopedUserManager.GenerateNewTwoFactorRecoveryCodesAsync(scopedUser, 10);
        }
        else
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/TwoFactorAuthentication", message, HttpContext);
        }
    }

    private async ValueTask LoadSharedKeyAndQrCodeUriAsync(UserManager<ApplicationUser> userManager, ApplicationUser user)
    {
        // Load the authenticator key & QR code URI to display on the form
        var unformattedKey = await userManager.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(unformattedKey))
        {
            await userManager.ResetAuthenticatorKeyAsync(user);
            unformattedKey = await userManager.GetAuthenticatorKeyAsync(user);
        }

        sharedKey = FormatKey(unformattedKey!);

        var email = await userManager.GetEmailAsync(user);
        authenticatorUri = GenerateQrCodeUri(email!, unformattedKey!);
    }

    private string FormatKey(string unformattedKey)
    {
        var result = new StringBuilder();
        int currentPosition = 0;
        while (currentPosition + 4 < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition, 4)).Append(' ');
            currentPosition += 4;
        }
        if (currentPosition < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition));
        }

        return result.ToString().ToLowerInvariant();
    }

    private string GenerateQrCodeUri(string email, string unformattedKey)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            AuthenticatorUriFormat,
            UrlEncoder.Encode("Microsoft.AspNetCore.Identity.UI"),
            UrlEncoder.Encode(email),
            unformattedKey);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El código de verificación es obligatorio.")]
        [StringLength(7, ErrorMessage = "La {0} debe tener entre {2} y {1} caracteres.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Código de verificación")]
        public string Code { get; set; } = "";
    }
}
