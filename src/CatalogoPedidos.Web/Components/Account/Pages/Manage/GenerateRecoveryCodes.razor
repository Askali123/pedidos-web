@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Códigos de recuperación</PageTitle>

<div class="max-w-xl">
@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <Card Title="Generar códigos de recuperación de 2FA">
        <Alert Variant="AlertVariant.Warning">
            <p><strong>Guardá estos códigos en un lugar seguro.</strong></p>
            <p class="mt-1">
                Si perdés tu dispositivo y no tenés los códigos de recuperación, vas a perder el acceso a tu cuenta.
            </p>
            <p class="mt-1">
                Generar nuevos códigos no cambia las claves que ya usan tus apps autenticadoras. Si querés cambiar
                esa clave, tenés que <a href="Account/Manage/ResetAuthenticator" class="underline">restablecer tu app autenticadora</a>.
            </p>
        </Alert>

        <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post" class="mt-4">
            <AntiforgeryToken />
            <Button Type="submit" Variant="ButtonVariant.Danger">Generar códigos de recuperación</Button>
        </form>
    </Card>
}
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Códigos de recuperación", [("Mi cuenta", "/Account/Manage"), ("Autenticación en dos pasos", "/Account/Manage/TwoFactorAuthentication"), ("Códigos de recuperación", null)]);

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var isTwoFactorEnabled = await scopedUserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Cannot generate recovery codes for user because they do not have 2FA enabled.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var scopedUser = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (scopedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var userId = await scopedUserManager.GetUserIdAsync(scopedUser);
        recoveryCodes = await scopedUserManager.GenerateNewTwoFactorRecoveryCodesAsync(scopedUser, 10);
        message = "Generaste nuevos códigos de recuperación.";

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
