@page "/Account/Manage/RenamePasskey/{Id}"

@using CatalogoPedidos.Infrastructure.Identity
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using System.Buffers.Text

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Renombrar passkey</PageTitle>

<div class="max-w-xl">
    <Card Title="@(passkey?.Name is { } name ? $"Renombrar la passkey \"{name}\"" : "Ponele un nombre a tu passkey")">
        <EditForm Model="Input" OnValidSubmit="Rename" FormName="rename-passkey" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger-400 text-sm mb-2" role="alert" />

            <FormField Label="Nombre de la passkey" Required="true">
                <InputText @bind-Value="Input.Name" id="Input.Name" class="form-input" aria-required="true" placeholder="Mi passkey" />
                <ValidationMessage For="() => Input.Name" class="text-danger-400 text-xs mt-1" />
            </FormField>

            <Button Type="submit" Variant="ButtonVariant.Primary" Icon="check">Continuar</Button>
        </EditForm>
    </Card>
</div>

@code {
    private ApplicationUser? user;
    private UserPasskeyInfo? passkey;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Renombrar passkey", [("Mi cuenta", "/Account/Manage"), ("Passkeys", "/Account/Manage/Passkeys"), ("Renombrar", null)]);

        Input ??= new();

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        user = (await scopedUserManager.GetUserAsync(HttpContext.User))!;
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        byte[] credentialId;
        try
        {
            credentialId = Base64Url.DecodeFromChars(Id);
        }
        catch (FormatException)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "Error: El ID de la passkey tiene un formato inválido.", HttpContext);
            return;
        }

        passkey = await scopedUserManager.GetPasskeyAsync(user, credentialId);
        if (passkey is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "Error: No se encontró la passkey especificada.", HttpContext);
            return;
        }
    }

    private async Task Rename()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var scopedUser = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (scopedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        passkey!.Name = Input.Name;
        var result = await scopedUserManager.AddOrUpdatePasskeyAsync(scopedUser, passkey);
        if (!result.Succeeded)
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "Error: No se pudo actualizar la passkey.", HttpContext);
            return;
        }

        RedirectManager.RedirectToWithStatus("Account/Manage/Passkeys", "Passkey actualizada correctamente.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(200, ErrorMessage = "El nombre no puede superar los {1} caracteres.")]
        public string Name { get; set; } = "";
    }
}
