@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Restablecer app autenticadora</PageTitle>

<div class="max-w-xl">
    <Card Title="Restablecer clave del autenticador">
        <StatusMessage />

        <Alert Variant="AlertVariant.Warning">
            <p><strong>Si restablecés la clave, tu app autenticadora no va a funcionar hasta que la reconfigures.</strong></p>
            <p class="mt-1">
                Este proceso desactiva el 2FA hasta que verifiques la app de nuevo. Si no completás la
                configuración, podrías perder el acceso a tu cuenta.
            </p>
        </Alert>

        <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post" class="mt-4">
            <AntiforgeryToken />
            <Button Type="submit" Variant="ButtonVariant.Danger">Restablecer clave del autenticador</Button>
        </form>
    </Card>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        HeaderState.Set("Restablecer app autenticadora", [("Mi cuenta", "/Account/Manage"), ("Autenticación en dos pasos", "/Account/Manage/TwoFactorAuthentication"), ("Restablecer app autenticadora", null)]);
    }

    private async Task OnSubmitAsync()
    {
        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var scopedSignInManager = scope.ServiceProvider.GetRequiredService<SignInManager<ApplicationUser>>();

        var user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await scopedUserManager.SetTwoFactorEnabledAsync(user, false);
        await scopedUserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await scopedUserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await scopedSignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Se restableció la clave del autenticador. Vas a tener que reconfigurar tu app con la nueva clave.",
            HttpContext);
    }
}
