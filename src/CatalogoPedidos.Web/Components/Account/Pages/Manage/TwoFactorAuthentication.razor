@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Autenticación en dos pasos</PageTitle>

<div class="max-w-xl">
    <Card Title="Autenticación en dos pasos (2FA)">
        <StatusMessage />

        @if (canTrack)
        {
            if (is2faEnabled)
            {
                if (recoveryCodesLeft == 0)
                {
                    <Alert Variant="AlertVariant.Danger">
                        <strong>No te quedan códigos de recuperación.</strong>
                        <p class="mt-1">Tenés que <a href="Account/Manage/GenerateRecoveryCodes" class="underline">generar un nuevo set de códigos</a> antes de poder iniciar sesión con uno.</p>
                    </Alert>
                }
                else if (recoveryCodesLeft == 1)
                {
                    <Alert Variant="AlertVariant.Danger">
                        <strong>Te queda 1 código de recuperación.</strong>
                        <p class="mt-1">Podés <a href="Account/Manage/GenerateRecoveryCodes" class="underline">generar un nuevo set de códigos</a>.</p>
                    </Alert>
                }
                else if (recoveryCodesLeft <= 3)
                {
                    <Alert Variant="AlertVariant.Warning">
                        <strong>Te quedan @recoveryCodesLeft códigos de recuperación.</strong>
                        <p class="mt-1">Convendría <a href="Account/Manage/GenerateRecoveryCodes" class="underline">generar un nuevo set de códigos</a>.</p>
                    </Alert>
                }

                <div class="flex items-center gap-2 flex-wrap mt-4">
                    @if (isMachineRemembered)
                    {
                        <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                            <AntiforgeryToken />
                            <Button Type="submit" Variant="ButtonVariant.Secondary">Olvidar este navegador</Button>
                        </form>
                    }
                    <a href="Account/Manage/Disable2fa" class="btn btn-secondary">Desactivar 2FA</a>
                    <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-secondary">Restablecer códigos de recuperación</a>
                </div>
            }

            <h4 class="mt-6">App autenticadora</h4>
            <div class="flex items-center gap-2 flex-wrap mt-2">
                @if (!hasAuthenticator)
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Agregar app autenticadora</a>
                }
                else
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn btn-secondary">Configurar app autenticadora</a>
                    <a href="Account/Manage/ResetAuthenticator" class="btn btn-secondary">Restablecer app autenticadora</a>
                }
            </div>
        }
        else
        {
            <Alert Variant="AlertVariant.Danger">
                <strong>No se aceptó la política de privacidad y cookies.</strong>
                <p class="mt-1">Tenés que aceptar la política antes de poder activar la autenticación en dos pasos.</p>
            </Alert>
        }
    </Card>
</div>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Autenticación en dos pasos", [("Mi cuenta", "/Account/Manage"), ("Autenticación en dos pasos", null)]);

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var scopedSignInManager = scope.ServiceProvider.GetRequiredService<SignInManager<ApplicationUser>>();

        var user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await scopedUserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await scopedUserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await scopedSignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await scopedUserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedSignInManager = scope.ServiceProvider.GetRequiredService<SignInManager<ApplicationUser>>();
        await scopedSignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Se olvidó este navegador. La próxima vez que inicies sesión desde acá, te vamos a pedir el código de 2FA.",
            HttpContext);
    }
}
