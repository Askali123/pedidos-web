@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Desactivar 2FA</PageTitle>

<div class="max-w-xl">
    <Card Title="Desactivar autenticación en dos pasos">
        <StatusMessage />

        <Alert Variant="AlertVariant.Warning">
            <p><strong>Esta acción solo desactiva el 2FA.</strong></p>
            <p class="mt-1">
                Desactivar el 2FA no cambia las claves que ya usan tus apps autenticadoras. Si querés cambiar
                esa clave, tenés que <a href="Account/Manage/ResetAuthenticator" class="underline">restablecer tu app autenticadora</a>.
            </p>
        </Alert>

        <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post" class="mt-4">
            <AntiforgeryToken />
            <Button Type="submit" Variant="ButtonVariant.Danger" Icon="x">Desactivar 2FA</Button>
        </form>
    </Card>
</div>

@code {
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Desactivar 2FA", [("Mi cuenta", "/Account/Manage"), ("Autenticación en dos pasos", "/Account/Manage/TwoFactorAuthentication"), ("Desactivar 2FA", null)]);

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await scopedUserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Cannot disable 2FA for user as it's not currently enabled.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var scopedUser = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (scopedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disable2faResult = await scopedUserManager.SetTwoFactorEnabledAsync(scopedUser, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred disabling 2FA.");
        }

        var userId = await scopedUserManager.GetUserIdAsync(scopedUser);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);
        RedirectManager.RedirectToWithStatus(
            "Account/Manage/TwoFactorAuthentication",
            "Se desactivó el 2FA. Podés volver a activarlo cuando configures una app autenticadora.",
            HttpContext);
    }
}
