@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Eliminar datos personales</PageTitle>

<div class="max-w-xl">
    <Card Title="Eliminar datos personales">
        <StatusMessage Message="@message" />

        <Alert Variant="AlertVariant.Warning">
            <strong>Eliminar estos datos borra tu cuenta de forma permanente y no se puede deshacer.</strong>
        </Alert>

        <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post" class="mt-4">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger-400 text-sm mb-2" role="alert" />

            @if (requirePassword)
            {
                <FormField Label="Contraseña" Required="true">
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-input" autocomplete="current-password" aria-required="true" placeholder="Ingresá tu contraseña" />
                    <ValidationMessage For="() => Input.Password" class="text-danger-400 text-xs mt-1" />
                </FormField>
            }

            <Button Type="submit" Variant="ButtonVariant.Danger" Icon="trash">Eliminar mis datos y cerrar mi cuenta</Button>
        </EditForm>
    </Card>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool requirePassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Eliminar datos personales", [("Mi cuenta", "/Account/Manage"), ("Datos personales", "/Account/Manage/PersonalData"), ("Eliminar", null)]);

        Input ??= new();

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await scopedUserManager.HasPasswordAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
        var scopedSignInManager = scope.ServiceProvider.GetRequiredService<SignInManager<ApplicationUser>>();

        var scopedUser = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (scopedUser is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await scopedUserManager.CheckPasswordAsync(scopedUser, Input.Password))
        {
            message = "Error: Contraseña incorrecta.";
            return;
        }

        var result = await scopedUserManager.DeleteAsync(scopedUser);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await scopedSignInManager.SignOutAsync();

        var userId = await scopedUserManager.GetUserIdAsync(scopedUser);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
