@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using CatalogoPedidos.Infrastructure.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Datos personales</PageTitle>

<div class="max-w-xl">
    <Card Title="Datos personales">
        <StatusMessage />

        <p class="text-sm text-gray-700">Tu cuenta contiene datos personales que nos diste. Desde acá podés descargarlos o eliminarlos.</p>
        <p class="text-sm text-gray-700 mt-2">
            <strong>Eliminar estos datos borra tu cuenta de forma permanente y no se puede deshacer.</strong>
        </p>

        <div class="flex items-center gap-2 mt-4">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <Button Type="submit" Variant="ButtonVariant.Secondary" Icon="download">Descargar</Button>
            </form>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Eliminar</a>
        </div>
    </Card>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Datos personales", [("Mi cuenta", "/Account/Manage"), ("Datos personales", null)]);

        // Scope aparte por la misma razón que en el resto de "Administrar cuenta" — ver
        // docs/PLAN_MEJORAS_AUTENTICACION.md #2.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedUserManager = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();

        var user = await scopedUserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
