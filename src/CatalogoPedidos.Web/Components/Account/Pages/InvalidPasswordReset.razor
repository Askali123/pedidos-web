@page "/Account/InvalidPasswordReset"
@attribute [AllowAnonymous]
@layout CatalogoPedidos.Web.Components.Layout.AuthLayout

<PageTitle>Enlace inválido</PageTitle>

<Card Title="Enlace inválido">
    <Alert Variant="AlertVariant.Danger">
        El enlace para restablecer la contraseña no es válido o ya expiró.
    </Alert>
    <div class="mt-4 text-sm text-center">
        <a href="Account/ForgotPassword" class="text-primary-300 hover:underline">Solicitar uno nuevo</a>
    </div>
</Card>
