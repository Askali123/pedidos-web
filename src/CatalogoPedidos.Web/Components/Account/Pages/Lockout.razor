@page "/Account/Lockout"
@layout CatalogoPedidos.Web.Components.Layout.AuthLayout

<PageTitle>Cuenta bloqueada</PageTitle>

<Card Title="Cuenta bloqueada">
    <Alert Variant="AlertVariant.Danger">
        Esta cuenta ha sido bloqueada por demasiados intentos fallidos. Intenta de nuevo más tarde.
    </Alert>
    <div class="mt-4 text-sm text-center">
        <a href="Account/Login" class="text-primary-700 hover:underline">Volver a iniciar sesión</a>
    </div>
</Card>
