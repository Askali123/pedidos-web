@page "/Account/ResetPasswordConfirmation"
@attribute [AllowAnonymous]
@layout CatalogoPedidos.Web.Components.Layout.AuthLayout

<PageTitle>Contraseña restablecida</PageTitle>

<Card Title="Contraseña restablecida">
    <Alert Variant="AlertVariant.Success">
        Tu contraseña fue restablecida correctamente.
    </Alert>
    <div class="mt-4 text-sm text-center">
        <a href="Account/Login" class="text-primary-700 hover:underline">Iniciar sesión</a>
    </div>
</Card>
