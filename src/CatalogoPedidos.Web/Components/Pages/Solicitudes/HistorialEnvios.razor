@page "/solicitudes/historial-envios"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IPedidoNotificacionProveedorService NotificacionesProveedor
@inject IProveedorService Proveedores
@inject PageHeaderState HeaderState

<PageTitle>Historial de envíos a proveedores</PageTitle>

<div class="space-y-4">
    <Card>
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label class="form-label">Desde</label>
                <input type="date" class="form-input w-auto" @bind="fechaDesde" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Hasta</label>
                <input type="date" class="form-input w-auto" @bind="fechaHasta" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Proveedor</label>
                <select class="form-select w-auto" @bind="proveedorIdTexto" @bind:after="Buscar">
                    <option value="">Todos los proveedores</option>
                    @foreach (var prov in proveedores)
                    {
                        <option value="@prov.Id">@prov.Nombre</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <Button Variant="ButtonVariant.Secondary" OnClick="LimpiarFiltros">Limpiar</Button>
            </div>
        </div>
    </Card>

    @if (resultados is null)
    {
        <Loading />
    }
    else if (resultados.Count == 0)
    {
        <div class="card"><EmptyState Icon="clock" Title="Sin envíos" Description="Ningún envío a proveedor coincide con estos filtros." /></div>
    }
    else
    {
        <p class="text-sm text-muted">@resultados.Count envío(s)</p>

        <div class="card table-wrap">
            <table class="table-enterprise">
                <thead>
                    <tr>
                        <th>Fecha de envío</th>
                        <th>Pedido</th>
                        <th>Proveedor</th>
                        <th>Correo</th>
                        <th>Líneas</th>
                        <th>Gestor</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var envio in paginaActual)
                    {
                        <tr>
                            <td class="text-muted">@envio.FechaEnvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="font-medium text-heading">#@envio.PedidoId</td>
                            <td>@envio.Proveedor?.Nombre</td>
                            <td class="text-muted">@envio.Email</td>
                            <td>@envio.CantidadLineas</td>
                            <td>@(envio.GestorNombre ?? "-")</td>
                            <td class="text-right"><a class="btn btn-secondary btn-sm" href="/api/pedidos/@envio.PedidoId/pdf" target="_blank">PDF del pedido</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <Pagination CurrentPage="paginaNumero" TotalPages="totalPaginas" CurrentPageChanged="p => paginaNumero = p" />
        </div>
    }
</div>

@code {
    private const int TamanoPagina = 20;

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string proveedorIdTexto = "";
    private int paginaNumero = 1;

    private int? proveedorId => int.TryParse(proveedorIdTexto, out var id) ? id : null;

    private List<NotificacionProveedor>? resultados;
    private List<Proveedor> proveedores = new();

    private int totalPaginas => Math.Max(1, (int)Math.Ceiling((resultados?.Count ?? 0) / (double)TamanoPagina));
    private IEnumerable<NotificacionProveedor> paginaActual =>
        (resultados ?? []).Skip((paginaNumero - 1) * TamanoPagina).Take(TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Historial de envíos a proveedores");
        proveedores = await Proveedores.ObtenerTodosAsync();
        await Buscar();
    }

    private async Task Buscar()
    {
        var filtro = new FiltroEnviosProveedorDto
        {
            ProveedorId = proveedorId,
            FechaDesde = fechaDesde,
            // Hasta es exclusivo: sumamos 1 día para incluir todo el día seleccionado.
            FechaHasta = fechaHasta?.AddDays(1)
        };

        resultados = await NotificacionesProveedor.BuscarEnviosAsync(filtro);
        paginaNumero = 1;
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = null;
        fechaHasta = null;
        proveedorIdTexto = "";
        await Buscar();
    }
}
