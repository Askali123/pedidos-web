@page "/solicitudes/historial-resoluciones"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject ISolicitudService Solicitudes
@inject PageHeaderState HeaderState

<PageTitle>Historial de resoluciones</PageTitle>

<div class="space-y-4">
    <Card>
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label class="form-label">Desde</label>
                <input type="date" class="form-input w-auto" @bind="fechaDesde" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Hasta</label>
                <input type="date" class="form-input w-auto" @bind="fechaHasta" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Gestor</label>
                <select class="form-select w-auto" @bind="gestorIdTexto" @bind:after="Buscar">
                    <option value="">Todos los gestores</option>
                    @foreach (var g in gestores)
                    {
                        <option value="@g.Id">@g.Nombre</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Resultado</label>
                <select class="form-select w-auto" @bind="estadoTexto" @bind:after="Buscar">
                    <option value="">Aprobadas y rechazadas</option>
                    <option value="@EstadoSolicitud.Aprobada">Aprobadas</option>
                    <option value="@EstadoSolicitud.Rechazada">Rechazadas</option>
                </select>
            </div>

            <div class="flex items-center gap-2">
                <Button Variant="ButtonVariant.Secondary" OnClick="LimpiarFiltros">Limpiar</Button>
            </div>
        </div>
    </Card>

    @if (resultados is null)
    {
        <Loading />
    }
    else if (resultados.Count == 0)
    {
        <div class="card"><EmptyState Icon="clock" Title="Sin resoluciones" Description="Ninguna resolución coincide con estos filtros." /></div>
    }
    else
    {
        <p class="text-sm text-gray-500">@resultados.Count resolución(es)</p>

        <div class="card table-wrap">
            <table class="table-enterprise">
                <thead>
                    <tr>
                        <th>Fecha de resolución</th>
                        <th>Pedido</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Resultado</th>
                        <th>Solicitante</th>
                        <th>Gestor</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in paginaActual)
                    {
                        <tr>
                            <td class="text-gray-500">@s.FechaResolucion?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="font-medium text-gray-900">#@s.PedidoId</td>
                            <td>@s.Producto?.Nombre</td>
                            <td>@s.Cantidad</td>
                            <td>
                                <Badge Variant="EstadoBadgeHelper.VariantePara(s.Estado)">@s.Estado</Badge>
                                @if (!string.IsNullOrWhiteSpace(s.ComentarioGestor))
                                {
                                    <p class="text-xs text-gray-500 mt-0.5">@s.ComentarioGestor</p>
                                }
                            </td>
                            <td>@s.SolicitanteNombre</td>
                            <td>@(s.GestorNombre ?? "-")</td>
                            <td class="text-right"><a class="btn btn-secondary btn-sm" href="/api/solicitudes/@s.Id/pdf" target="_blank">PDF</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card">
            <Pagination CurrentPage="paginaNumero" TotalPages="totalPaginas" CurrentPageChanged="p => paginaNumero = p" />
        </div>
    }
</div>

@code {
    private const int TamanoPagina = 20;

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string gestorIdTexto = "";
    private string estadoTexto = "";
    private int paginaNumero = 1;

    private List<SolicitudProducto>? resultados;
    private List<GestorResumenDto> gestores = new();

    private int totalPaginas => Math.Max(1, (int)Math.Ceiling((resultados?.Count ?? 0) / (double)TamanoPagina));
    private IEnumerable<SolicitudProducto> paginaActual =>
        (resultados ?? []).Skip((paginaNumero - 1) * TamanoPagina).Take(TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Historial de resoluciones");
        gestores = await Solicitudes.ObtenerGestoresAsync();
        await Buscar();
    }

    private async Task Buscar()
    {
        var filtro = new FiltroHistorialResolucionesDto
        {
            GestorId = string.IsNullOrEmpty(gestorIdTexto) ? null : gestorIdTexto,
            FechaDesde = fechaDesde,
            // Hasta es exclusivo: sumamos 1 día para incluir todo el día seleccionado.
            FechaHasta = fechaHasta?.AddDays(1),
            Estado = string.IsNullOrEmpty(estadoTexto) ? null : Enum.Parse<EstadoSolicitud>(estadoTexto)
        };

        resultados = await Solicitudes.BuscarResueltasAsync(filtro);
        paginaNumero = 1;
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = null;
        fechaHasta = null;
        gestorIdTexto = "";
        estadoTexto = "";
        await Buscar();
    }
}
