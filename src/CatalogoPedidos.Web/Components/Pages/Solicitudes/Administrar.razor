@page "/solicitudes/administrar"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject ISolicitudService Solicitudes
@inject IProductoService Productos
@inject IProveedorService Proveedores
@inject IPedidoNotificacionProveedorService NotificacionesProveedor
@inject PageHeaderState HeaderState

<PageTitle>Administrar pedidos</PageTitle>

<div class="space-y-4">
    <Card>
        <div class="flex flex-wrap items-end gap-4">
            <div>
                <label class="form-label">Desde</label>
                <input type="date" class="form-input w-auto" @bind="fechaDesde" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Hasta</label>
                <input type="date" class="form-input w-auto" @bind="fechaHasta" @bind:after="Buscar" />
            </div>

            <div>
                <label class="form-label">Usuario</label>
                <select class="form-select w-auto" @bind="solicitanteId" @bind:after="Buscar">
                    <option value="">Todos</option>
                    @foreach (var s in solicitantes)
                    {
                        <option value="@s.Id">@s.Nombre</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Producto</label>
                <select class="form-select w-auto" @bind="productoId" @bind:after="Buscar">
                    <option value="">Todos</option>
                    @foreach (var p in catalogo)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label">Estado</label>
                <select class="form-select w-auto" @bind="estado" @bind:after="Buscar">
                    <option value="">Todos</option>
                    <option value="@EstadoSolicitud.Pendiente">Pendiente</option>
                    <option value="@EstadoSolicitud.Aprobada">Aprobada</option>
                    <option value="@EstadoSolicitud.Rechazada">Rechazada</option>
                </select>
            </div>

            <div>
                <label class="form-label">Proveedor</label>
                <select class="form-select w-auto" @bind="proveedorIdTexto" @bind:after="Buscar">
                    <option value="">Todos los proveedores</option>
                    @foreach (var prov in proveedores)
                    {
                        <option value="@prov.Id">@prov.Nombre</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2">
                <Button Variant="ButtonVariant.Secondary" OnClick="LimpiarFiltros">Limpiar</Button>
                <a class="btn btn-secondary" href="@UrlReporte("pdf")" target="_blank"><Icon Name="download" Class="h-4 w-4" />PDF</a>
                <a class="btn btn-success" href="@UrlReporte("excel")" target="_blank"><Icon Name="download" Class="h-4 w-4" />Excel</a>
            </div>
        </div>
    </Card>

    @if (resultados is null)
    {
        <Loading />
    }
    else if (resultados.Count == 0)
    {
        <div class="card"><EmptyState Icon="adjustments" Title="Sin resultados" Description="Ningún pedido coincide con estos filtros." /></div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(mensajeEnvio))
        {
            <Alert Variant="mensajeEnvioVariante" Dismissible="true" OnDismiss="() => mensajeEnvio = null">@mensajeEnvio</Alert>
        }

        <p class="text-sm text-gray-500">@resultados.Count solicitud(es) en @gruposPedido.Count pedido(s)</p>

        @foreach (var grupo in paginaActual)
        {
            <Card>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <div>
                        <p class="font-medium text-gray-900">Pedido #@grupo.Key.PedidoId · @grupo.Key.SolicitanteNombre</p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            @grupo.Key.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(grupo.Key.Comentario))
                            {
                                <span> · @grupo.Key.Comentario</span>
                            }
                        </p>
                    </div>
                    <div class="flex items-center gap-2">
                        <a class="btn btn-secondary btn-sm" href="/api/pedidos/@grupo.Key.PedidoId/pdf" target="_blank">
                            <Icon Name="download" Class="h-4 w-4" /> PDF del pedido
                        </a>
                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="mail" OnClick="() => EnviarAProveedores(grupo.Key.PedidoId)">Enviar a proveedor</Button>
                    </div>
                </div>

                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>N.º</th>
                                <th>Producto</th>
                                @if (proveedorId is not null)
                                {
                                    <th>Código interno</th>
                                    <th>Código proveedor</th>
                                }
                                else
                                {
                                    <th>Proveedor · Código</th>
                                }
                                <th>Cantidad</th>
                                <th>Estado</th>
                                <th>Gestor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in grupo)
                            {
                                <tr>
                                    <td class="text-gray-400">#@s.Id</td>
                                    <td class="font-medium text-gray-900">@s.Producto?.Nombre</td>
                                    @if (proveedorId is not null)
                                    {
                                        <td class="text-gray-500">#@s.ProductoId</td>
                                        <td class="font-medium text-gray-900">@codigosProveedorPorProducto.GetValueOrDefault(s.ProductoId, "-")</td>
                                    }
                                    else
                                    {
                                        <td class="text-gray-500">
                                            @if (codigosPreferidosPorProducto.TryGetValue(s.ProductoId, out var pp))
                                            {
                                                @($"{pp.Proveedor!.Nombre} · {pp.CodigoProveedor}")
                                            }
                                            else
                                            {
                                                @:—
                                            }
                                        </td>
                                    }
                                    <td>@s.Cantidad</td>
                                    <td><Badge Variant="EstadoBadgeHelper.VariantePara(s.Estado)">@s.Estado</Badge></td>
                                    <td>@(s.GestorNombre ?? "-")</td>
                                    <td class="text-right"><a class="btn btn-secondary btn-sm" href="/api/solicitudes/@s.Id/pdf" target="_blank">PDF</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Card>
        }

        <div class="card">
            <Pagination CurrentPage="paginaNumero" TotalPages="totalPaginas" CurrentPageChanged="p => paginaNumero = p" />
        </div>
    }
</div>

@code {
    private const int TamanoPagina = 8;

    private record PedidoResumen(int PedidoId, string SolicitanteNombre, string? Comentario, DateTime FechaCreacion);

    private DateTime? fechaDesde;
    private DateTime? fechaHasta;
    private string solicitanteId = "";
    private string productoId = "";
    private string estado = "";
    private string proveedorIdTexto = "";
    private int paginaNumero = 1;

    private int? proveedorId => int.TryParse(proveedorIdTexto, out var id) ? id : null;

    private List<SolicitudProducto>? resultados;
    private List<IGrouping<PedidoResumen, SolicitudProducto>> gruposPedido = new();
    private List<SolicitanteResumenDto> solicitantes = new();
    private List<Producto> catalogo = new();
    private List<Proveedor> proveedores = new();
    private Dictionary<int, string> codigosProveedorPorProducto = new();
    private Dictionary<int, ProductoProveedor> codigosPreferidosPorProducto = new();
    private string? mensajeEnvio;
    private AlertVariant mensajeEnvioVariante = AlertVariant.Success;

    // Paginación por pedido (no por línea de solicitud): cada página agrupa varios pedidos
    // completos, igual que la Bandeja, para poder ver de un vistazo todo lo que pidió cada
    // solicitante en un mismo envío.
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(gruposPedido.Count / (double)TamanoPagina));
    private IEnumerable<IGrouping<PedidoResumen, SolicitudProducto>> paginaActual =>
        gruposPedido.Skip((paginaNumero - 1) * TamanoPagina).Take(TamanoPagina);

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Administrar pedidos", [("Administrar pedidos", null)]);
        solicitantes = await Solicitudes.ObtenerSolicitantesAsync();
        catalogo = await Productos.ObtenerCatalogoAsync();
        proveedores = await Proveedores.ObtenerTodosAsync();
        await Buscar();
    }

    private async Task Buscar()
    {
        var filtro = new FiltroSolicitudesDto
        {
            FechaDesde = fechaDesde,
            // Hasta es exclusivo: sumamos 1 día para incluir todo el día seleccionado.
            FechaHasta = fechaHasta?.AddDays(1),
            SolicitanteId = string.IsNullOrEmpty(solicitanteId) ? null : solicitanteId,
            ProductoId = string.IsNullOrEmpty(productoId) ? null : int.Parse(productoId),
            ProveedorId = proveedorId,
            Estado = string.IsNullOrEmpty(estado) ? null : Enum.Parse<EstadoSolicitud>(estado)
        };

        resultados = await Solicitudes.BuscarAsync(filtro);

        gruposPedido = resultados
            .GroupBy(s => new PedidoResumen(s.PedidoId, s.Pedido?.SolicitanteNombre ?? s.SolicitanteNombre, s.Pedido?.Comentario, s.Pedido?.FechaCreacion ?? s.FechaSolicitud))
            .OrderByDescending(g => g.Key.FechaCreacion)
            .ToList();

        if (proveedorId is int id)
        {
            // Filtrando por un proveedor específico: mostrar SU código exacto (el que va en el
            // pedido que se le envía), no una referencia general.
            codigosProveedorPorProducto = (await Proveedores.ObtenerProductosDeProveedorAsync(id)).ToDictionary(pp => pp.ProductoId, pp => pp.CodigoProveedor);
            codigosPreferidosPorProducto = new Dictionary<int, ProductoProveedor>();
        }
        else
        {
            // Sin filtrar por proveedor: mostrar el proveedor preferido de cada producto como
            // referencia, para no depender de que el gestor filtre uno por uno para verlo.
            codigosProveedorPorProducto = new Dictionary<int, string>();
            codigosPreferidosPorProducto = await Proveedores.ObtenerCodigosPreferidosAsync(resultados.Select(s => s.ProductoId));
        }

        paginaNumero = 1;
    }

    private async Task LimpiarFiltros()
    {
        fechaDesde = null;
        fechaHasta = null;
        solicitanteId = "";
        productoId = "";
        estado = "";
        proveedorIdTexto = "";
        await Buscar();
    }

    private async Task EnviarAProveedores(int pedidoId)
    {
        var resultados = await NotificacionesProveedor.EnviarAProveedoresAsync(pedidoId);

        var enviados = resultados.Where(r => r.Enviado).Select(r => r.ProveedorNombre).ToList();
        var noEnviados = resultados.Where(r => !r.Enviado).ToList();

        var partes = new List<string>();
        if (enviados.Count > 0)
            partes.Add($"Pedido #{pedidoId} enviado a: {string.Join(", ", enviados)}.");
        if (noEnviados.Count > 0)
            partes.Add("No enviado: " + string.Join("; ", noEnviados.Select(r => $"{r.ProveedorNombre} ({r.Motivo})")));

        mensajeEnvio = string.Join(" ", partes);
        mensajeEnvioVariante = noEnviados.Count > 0 ? AlertVariant.Warning : AlertVariant.Success;
    }

    private string UrlReporte(string formato)
    {
        var query = new List<string>();

        if (fechaDesde is not null) query.Add($"desde={fechaDesde:yyyy-MM-dd}");
        if (fechaHasta is not null) query.Add($"hasta={fechaHasta.Value.AddDays(1):yyyy-MM-dd}");
        if (!string.IsNullOrEmpty(solicitanteId)) query.Add($"solicitanteId={Uri.EscapeDataString(solicitanteId)}");
        if (!string.IsNullOrEmpty(productoId)) query.Add($"productoId={productoId}");
        if (!string.IsNullOrEmpty(proveedorIdTexto)) query.Add($"proveedorId={proveedorIdTexto}");
        if (!string.IsNullOrEmpty(estado)) query.Add($"estado={estado}");

        var queryString = query.Count > 0 ? "?" + string.Join("&", query) : "";
        return $"/api/solicitudes/reporte/{formato}{queryString}";
    }
}
