@page "/solicitudes/mis-solicitudes"
@attribute [Authorize]
@using System.Security.Claims
@inject ISolicitudService Solicitudes
@inject PageHeaderState HeaderState

<PageTitle>Mis solicitudes</PageTitle>

@if (grupos is null)
{
    <div class="card"><Loading /></div>
}
else if (grupos.Count == 0)
{
    <div class="card">
        <EmptyState Icon="clipboard-list" Title="Sin solicitudes" Description="Todavía no has enviado ninguna solicitud.">
            <Action>
                <a href="/catalogo" class="btn btn-primary btn-sm">Ir al catálogo</a>
            </Action>
        </EmptyState>
    </div>
}
else
{
    <div class="space-y-4">
        @foreach (var grupo in grupos)
        {
            <Card>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <div>
                        <p class="font-medium text-gray-900">Pedido #@grupo.Key.PedidoId</p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            @grupo.Key.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(grupo.Key.Comentario))
                            {
                                <span> · @grupo.Key.Comentario</span>
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(grupo.Key.DireccionEntrega))
                        {
                            <p class="text-xs text-gray-500 mt-0.5">Dirección de entrega: @grupo.Key.DireccionEntrega</p>
                        }
                    </div>

                    @if (grupo.Count() > 1)
                    {
                        <a class="btn btn-secondary btn-sm" href="/api/pedidos/@grupo.Key.PedidoId/pdf" target="_blank">PDF del pedido</a>
                    }
                </div>

                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Cantidad</th>
                                <th>Estado</th>
                                <th>Gestor</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in grupo)
                            {
                                <tr>
                                    <td class="font-medium text-gray-900">@s.Producto?.Nombre</td>
                                    <td>@s.Cantidad</td>
                                    <td>
                                        <Badge Variant="EstadoBadgeHelper.VariantePara(s.Estado)">@s.Estado</Badge>
                                        @if (!string.IsNullOrWhiteSpace(s.ComentarioGestor))
                                        {
                                            <p class="text-xs text-gray-500 mt-0.5">@s.ComentarioGestor</p>
                                        }
                                    </td>
                                    <td>@s.GestorNombre</td>
                                    <td class="text-right"><a class="btn btn-secondary btn-sm" href="/api/solicitudes/@s.Id/pdf" target="_blank">PDF</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Card>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private record PedidoResumen(int PedidoId, string? Comentario, string? DireccionEntrega, DateTime FechaCreacion);

    private List<IGrouping<PedidoResumen, SolicitudProducto>>? grupos;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Mis solicitudes", [("Mis solicitudes", null)]);

        var authState = await AuthStateTask!;
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        var solicitudes = await Solicitudes.ObtenerMisSolicitudesAsync(userId);

        grupos = solicitudes
            .GroupBy(s => new PedidoResumen(s.PedidoId, s.Pedido?.Comentario, s.Pedido?.DireccionEntrega, s.Pedido?.FechaCreacion ?? s.FechaSolicitud))
            .OrderByDescending(g => g.Key.FechaCreacion)
            .ToList();
    }
}
