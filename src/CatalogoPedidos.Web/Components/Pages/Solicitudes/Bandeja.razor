@page "/solicitudes/bandeja"
@attribute [Authorize(Roles = Roles.Gestor)]
@using System.Security.Claims
@inject ISolicitudService Solicitudes

<PageTitle>Bandeja de solicitudes</PageTitle>

<h1>Bandeja de solicitudes pendientes</h1>

@if (solicitudes is null)
{
    <p>Cargando...</p>
}
else if (solicitudes.Count == 0)
{
    <p>No hay solicitudes pendientes por resolver.</p>
}
else
{
    <table class="tabla">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Solicitante</th>
                <th>Comentario</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in solicitudes)
            {
                var urgente = DateTime.UtcNow - s.FechaSolicitud > TimeSpan.FromHours(48);
                <tr class="@(urgente ? "urgente" : "")">
                    <td>@s.Producto?.Nombre</td>
                    <td>@s.Cantidad</td>
                    <td>@s.SolicitanteNombre</td>
                    <td>@s.Comentario</td>
                    <td>
                        @s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        @if (urgente)
                        {
                            <span class="badge-urgente" title="Pendiente hace más de 48 horas">⚠ Urgente</span>
                        }
                    </td>
                    <td class="acciones">
                        <button class="btn aprobar" @onclick="() => Resolver(s.Id, true)">Aprobar</button>
                        <button class="btn rechazar" @onclick="() => Resolver(s.Id, false)">Rechazar</button>
                        <a class="btn" href="/api/solicitudes/@s.Id/pdf" target="_blank">PDF</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <p class="mensaje">@mensaje</p>
}

<style>
    .tabla { width: 100%; border-collapse: collapse; }
    .tabla th, .tabla td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #ddd; vertical-align: top; }
    .acciones { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 0.3rem 0.6rem; background: #1b1f27; color: white; text-decoration: none; border-radius: 4px; border: none; cursor: pointer; }
    .btn.aprobar { background: #1e7e34; }
    .btn.rechazar { background: #b02a37; }
    .mensaje { margin-top: 1rem; color: green; }
    tr.urgente { background: #fff5f5; }
    .badge-urgente { display: inline-block; margin-left: 0.5rem; background: #f8d7da; color: #721c24; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.75rem; }
</style>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }
    private List<SolicitudProducto>? solicitudes;
    private string? mensaje;

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        solicitudes = await Solicitudes.ObtenerBandejaAsync();
    }

    private async Task Resolver(int solicitudId, bool aprobar)
    {
        var authState = await AuthStateTask!;
        var gestorId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        var gestorNombre = authState.User.Identity?.Name ?? "Gestor";

        await Solicitudes.ResolverAsync(solicitudId, gestorId, gestorNombre, new ResolverSolicitudDto { Aprobar = aprobar });

        mensaje = aprobar ? $"Solicitud #{solicitudId} aprobada." : $"Solicitud #{solicitudId} rechazada.";
        await Cargar();
    }
}
