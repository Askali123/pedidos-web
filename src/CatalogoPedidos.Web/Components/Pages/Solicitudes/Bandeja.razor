@page "/solicitudes/bandeja"
@attribute [Authorize(Roles = Roles.Gestor)]
@using System.Security.Claims
@inject ISolicitudService Solicitudes
@inject IProveedorService Proveedores
@inject IPedidoNotificacionProveedorService NotificacionesProveedor
@inject UserManager<ApplicationUser> UserManager
@inject PageHeaderState HeaderState

<PageTitle>Bandeja de solicitudes</PageTitle>

<div class="space-y-4">
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <Alert Variant="mensajeVariante" Dismissible="true" OnDismiss="() => mensaje = null">@mensaje</Alert>
    }

    @if (grupos is null)
    {
        <div class="card"><Loading /></div>
    }
    else if (grupos.Count == 0)
    {
        <div class="card"><EmptyState Icon="inbox" Title="Todo al día" Description="No hay solicitudes pendientes por resolver." /></div>
    }
    else
    {
        @foreach (var grupo in grupos)
        {
            var urgente = DateTime.UtcNow - grupo.Key.FechaCreacion > TimeSpan.FromHours(48);
            <Card>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                    <div>
                        <p class="font-medium text-gray-900">
                            Pedido #@grupo.Key.PedidoId · @grupo.Key.SolicitanteNombre
                            @if (urgente)
                            {
                                <Badge Variant="BadgeVariant.Danger">⚠ Urgente</Badge>
                            }
                        </p>
                        <p class="text-xs text-gray-500 mt-0.5">
                            @grupo.Key.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            @if (!string.IsNullOrWhiteSpace(grupo.Key.Comentario))
                            {
                                <span> · @grupo.Key.Comentario</span>
                            }
                        </p>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (grupo.Count() > 1)
                        {
                            <Button Variant="ButtonVariant.Success" Size="ButtonSize.Small" Icon="check" OnClick="() => ResolverPedido(grupo.Key.PedidoId, true)">Aprobar todo</Button>
                            <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="x" OnClick="() => ResolverPedido(grupo.Key.PedidoId, false)">Rechazar todo</Button>
                        }
                        <a class="btn btn-secondary btn-sm" href="/api/pedidos/@grupo.Key.PedidoId/pdf" target="_blank">PDF del pedido</a>

                        <Dropdown AlignRight="true">
                            <Trigger>
                                <span class="btn btn-secondary btn-sm">
                                    <Icon Name="mail" Class="h-4 w-4" /> Enviar a proveedor <Icon Name="chevron-down" Class="h-3.5 w-3.5" />
                                </span>
                            </Trigger>
                            <ChildContent>
                                <div class="w-60 bg-white border border-gray-200 rounded-lg shadow-lg py-1">
                                    @if (proveedoresPorPedido.TryGetValue(grupo.Key.PedidoId, out var opciones) && opciones.Count > 0)
                                    {
                                        @foreach (var op in opciones)
                                        {
                                            <button type="button" class="w-full flex items-center justify-between gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" @onclick="() => PedirConfirmacionEnvio(grupo.Key.PedidoId, op)">
                                                <span>@op.ProveedorNombre</span>
                                                <span class="text-xs text-gray-400">@op.CantidadLineas prod.</span>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <p class="px-3 py-2 text-sm text-gray-400">Aprueba al menos una línea con proveedor asociado para poder enviarla.</p>
                                    }
                                </div>
                            </ChildContent>
                        </Dropdown>
                    </div>
                </div>

                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Proveedor · Código</th>
                                <th>Cantidad</th>
                                <th class="text-right">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in grupo)
                            {
                                <tr>
                                    <td class="font-medium text-gray-900">@s.Producto?.Nombre</td>
                                    <td class="text-gray-500">
                                        @if (codigosPorProducto.TryGetValue(s.ProductoId, out var pp))
                                        {
                                            @($"{pp.Proveedor!.Nombre} · {pp.CodigoProveedor}")
                                        }
                                        else
                                        {
                                            @:—
                                        }
                                    </td>
                                    <td>@s.Cantidad</td>
                                    <td>
                                        <div class="flex items-center gap-2 justify-end">
                                            <Button Variant="ButtonVariant.Success" Size="ButtonSize.Small" Icon="check" OnClick="() => Resolver(s.Id, true)">Aprobar</Button>
                                            <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="x" OnClick="() => Resolver(s.Id, false)">Rechazar</Button>
                                            <a class="btn btn-secondary btn-sm" href="/api/solicitudes/@s.Id/pdf" target="_blank">PDF</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Card>
        }
    }
</div>

<ConfirmDialog @bind-Visible="confirmandoEnvio" Title="Enviar a proveedor"
               Message="@($"¿Enviar el pedido #{pedidoPendienteEnvio} a \"{proveedorPendienteEnvio?.ProveedorNombre}\" ({proveedorPendienteEnvio?.CantidadLineas} producto(s))? Se le manda un correo real con el detalle en PDF — no se puede deshacer.")"
               ConfirmText="Enviar" OnConfirm="ConfirmarEnvio" />

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private record PedidoResumen(int PedidoId, string SolicitanteNombre, string? Comentario, DateTime FechaCreacion);

    private List<IGrouping<PedidoResumen, SolicitudProducto>>? grupos;
    private Dictionary<int, ProductoProveedor> codigosPorProducto = new();
    private Dictionary<int, List<ProveedorDelPedidoDto>> proveedoresPorPedido = new();
    private string? mensaje;
    private AlertVariant mensajeVariante = AlertVariant.Success;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Bandeja de solicitudes", [("Bandeja de solicitudes", null)]);
        await Cargar();
    }

    private async Task Cargar()
    {
        var solicitudes = await Solicitudes.ObtenerBandejaAsync();
        grupos = solicitudes
            .GroupBy(s => new PedidoResumen(s.PedidoId, s.Pedido?.SolicitanteNombre ?? s.SolicitanteNombre, s.Pedido?.Comentario, s.Pedido?.FechaCreacion ?? s.FechaSolicitud))
            .OrderBy(g => g.Key.FechaCreacion)
            .ToList();

        codigosPorProducto = await Proveedores.ObtenerCodigosPreferidosAsync(solicitudes.Select(s => s.ProductoId));

        proveedoresPorPedido.Clear();
        foreach (var pedidoId in grupos.Select(g => g.Key.PedidoId))
            proveedoresPorPedido[pedidoId] = await NotificacionesProveedor.ObtenerProveedoresDisponiblesAsync(pedidoId);
    }

    private async Task<(string GestorId, string GestorNombre)> DatosGestor(Microsoft.AspNetCore.Components.Authorization.AuthenticationState authState)
    {
        var gestorId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        var appUser = await UserManager.GetUserAsync(authState.User);
        var gestorNombre = appUser.NombreParaMostrar(authState.User.Identity?.Name ?? "Gestor");
        return (gestorId, gestorNombre);
    }

    private async Task Resolver(int solicitudId, bool aprobar)
    {
        var (gestorId, gestorNombre) = await DatosGestor(await AuthStateTask!);

        await Solicitudes.ResolverAsync(solicitudId, gestorId, gestorNombre, new ResolverSolicitudDto { Aprobar = aprobar });

        mensaje = aprobar ? $"Solicitud #{solicitudId} aprobada." : $"Solicitud #{solicitudId} rechazada.";
        await Cargar();
    }

    private async Task ResolverPedido(int pedidoId, bool aprobar)
    {
        var (gestorId, gestorNombre) = await DatosGestor(await AuthStateTask!);

        var resueltas = await Solicitudes.ResolverPedidoAsync(pedidoId, gestorId, gestorNombre, new ResolverSolicitudDto { Aprobar = aprobar });

        mensaje = aprobar
            ? $"Pedido #{pedidoId} aprobado ({resueltas.Count} producto(s))."
            : $"Pedido #{pedidoId} rechazado ({resueltas.Count} producto(s)).";
        mensajeVariante = AlertVariant.Success;
        await Cargar();
    }

    private bool confirmandoEnvio;
    private int pedidoPendienteEnvio;
    private ProveedorDelPedidoDto? proveedorPendienteEnvio;

    private void PedirConfirmacionEnvio(int pedidoId, ProveedorDelPedidoDto proveedor)
    {
        pedidoPendienteEnvio = pedidoId;
        proveedorPendienteEnvio = proveedor;
        confirmandoEnvio = true;
    }

    private async Task ConfirmarEnvio()
    {
        if (proveedorPendienteEnvio is null)
            return;

        var resultado = await NotificacionesProveedor.EnviarAProveedorAsync(pedidoPendienteEnvio, proveedorPendienteEnvio.ProveedorId);

        mensaje = resultado.Enviado
            ? $"Pedido #{pedidoPendienteEnvio} enviado a {resultado.ProveedorNombre} (PDF adjunto, {resultado.CantidadLineas} producto(s))."
            : $"No se pudo enviar a {resultado.ProveedorNombre}: {resultado.Motivo}";
        mensajeVariante = resultado.Enviado ? AlertVariant.Success : AlertVariant.Warning;
    }
}
