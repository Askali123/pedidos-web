@page "/catalogo/{ProductoId:int}/proveedores"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IProveedorService ProveedorService
@inject IProductoService ProductoService
@inject PageHeaderState HeaderState

<PageTitle>Proveedores del producto</PageTitle>

@if (producto is null)
{
    <Loading />
}
else
{
    <div class="space-y-6 max-w-3xl">
        <Card Title="@($"Proveedores de \"{producto.Nombre}\"")"
              Subtitle="@($"Cada proveedor identifica este producto con SU PROPIO código — por eso se guarda por separado del Id interno (#{producto.Id}).")">

            @if (asociaciones is null)
            {
                <Loading />
            }
            else if (asociaciones.Count == 0)
            {
                <EmptyState Icon="truck" Title="Sin proveedores" Description="Este producto todavía no tiene proveedores asociados." />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Código del proveedor</th>
                                <th>Precio del proveedor</th>
                                <th>Preferido</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in asociaciones)
                            {
                                <tr>
                                    <td class="font-medium text-heading">@a.Proveedor?.Nombre</td>
                                    <td><code class="text-xs bg-card-elevated px-1.5 py-0.5 rounded">@a.CodigoProveedor</code></td>
                                    <td>@(a.PrecioProveedor is not null ? a.PrecioProveedor.Value.ToString("C") : "-")</td>
                                    <td>
                                        @if (a.EsPreferido)
                                        {
                                            <Badge Variant="BadgeVariant.Success">★ Preferido</Badge>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="trash" OnClick="() => PedirConfirmacionQuitar(a.Id, a.Proveedor?.Nombre)">Quitar</Button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>

        <Card Title="Asociar un proveedor">
            <EditForm Model="modelo" OnValidSubmit="Asociar" FormName="asociar-proveedor">
                <FormField Label="Proveedor" Required="true">
                    <select class="form-select" @bind="modelo.ProveedorId">
                        <option value="0">Selecciona uno...</option>
                        @foreach (var p in proveedoresDisponibles)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </FormField>

                <FormField Label="Código con el que ESE proveedor identifica este producto" Required="true" Hint="Es el SKU/referencia propio del proveedor, no el Id interno del catálogo.">
                    <InputText @bind-Value="modelo.CodigoProveedor" class="form-input" placeholder="p.ej. SKU-8827-A" />
                </FormField>

                <FormField Label="Precio del proveedor (opcional)">
                    <InputNumber @bind-Value="modelo.PrecioProveedor" class="form-input" />
                </FormField>

                <label class="flex items-center gap-2 text-sm text-body mb-4">
                    <InputCheckbox @bind-Value="modelo.EsPreferido" class="form-checkbox" />
                    Marcar como proveedor preferido
                </label>

                @if (!string.IsNullOrEmpty(error))
                {
                    <Alert Variant="AlertVariant.Danger">@error</Alert>
                }
                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <Alert Variant="AlertVariant.Success">@mensaje</Alert>
                }

                <div class="mt-4">
                    <Button Type="submit" Variant="ButtonVariant.Primary" Icon="plus">Asociar proveedor</Button>
                </div>
            </EditForm>
        </Card>

        <p class="text-sm">
            <a href="/proveedores" class="text-primary-300 hover:underline">Ver todos los proveedores</a>
            <span class="text-muted/50 mx-2">·</span>
            <a href="/catalogo" class="text-primary-300 hover:underline">Volver al catálogo</a>
        </p>
    </div>
}

<ConfirmDialog @bind-Visible="confirmandoQuitar" Title="Quitar proveedor" Danger="true"
               Message="@($"¿Quitar a \"{proveedorAQuitarNombre}\" de este producto?")"
               ConfirmText="Quitar" OnConfirm="ConfirmarQuitar" />

@code {
    [Parameter] public int ProductoId { get; set; }

    private Producto? producto;
    private List<ProductoProveedor>? asociaciones;
    private List<Proveedor> proveedoresDisponibles = new();
    private AsociarProveedorDto modelo = new();
    private string? error;
    private string? mensaje;

    private bool confirmandoQuitar;
    private int asociacionAQuitarId;
    private string? proveedorAQuitarNombre;

    protected override async Task OnInitializedAsync()
    {
        modelo.ProductoId = ProductoId;
        producto = await ProductoService.ObtenerPorIdAsync(ProductoId);
        proveedoresDisponibles = await ProveedorService.ObtenerTodosAsync();
        await Cargar();

        HeaderState.Set("Proveedores del producto", [("Catálogo", "/catalogo"), (producto?.Nombre ?? "Producto", null), ("Proveedores", null)]);
    }

    private async Task Cargar()
    {
        asociaciones = await ProveedorService.ObtenerProveedoresDeProductoAsync(ProductoId);
    }

    private async Task Asociar()
    {
        error = null;
        mensaje = null;

        if (modelo.ProveedorId == 0)
        {
            error = "Selecciona un proveedor.";
            return;
        }

        try
        {
            await ProveedorService.AsociarProveedorAsync(modelo);
            mensaje = "Proveedor asociado correctamente.";
            modelo = new() { ProductoId = ProductoId };
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private void PedirConfirmacionQuitar(int asociacionId, string? proveedorNombre)
    {
        asociacionAQuitarId = asociacionId;
        proveedorAQuitarNombre = proveedorNombre;
        confirmandoQuitar = true;
    }

    private async Task ConfirmarQuitar()
    {
        await ProveedorService.QuitarAsociacionAsync(asociacionAQuitarId);
        await Cargar();
    }
}
