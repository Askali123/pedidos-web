@page "/catalogo/{ProductoId:int}/proveedores"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IProveedorService ProveedorService
@inject IProductoService ProductoService
@inject PageHeaderState HeaderState

<PageTitle>Proveedores del producto</PageTitle>

@if (producto is null)
{
    <Loading />
}
else
{
    <div class="space-y-6 max-w-3xl">
        @if (!producto.Activo)
        {
            <Alert Variant="AlertVariant.Warning">
                Este producto está <strong>desactivado</strong> — no aparece en el catálogo ni puede solicitarse. Reactivalo desde <a class="underline" href="/catalogo">el catálogo</a> si hace falta volver a ofrecerlo.
            </Alert>
        }
        <Card Title="@($"Proveedores de \"{producto.Nombre}\"")"
              Subtitle="@($"Cada proveedor identifica este producto con SU PROPIO código — por eso se guarda por separado del Id interno (#{producto.Id}). Quitar un proveedor lo desactiva (no lo borra): los pedidos ya emitidos conservan sus datos y solo dejan de ofrecerse los nuevos.")">

            @if (asociaciones is null)
            {
                <Loading />
            }
            else if (asociaciones.Count == 0)
            {
                <EmptyState Icon="truck" Title="Sin proveedores" Description="Este producto todavía no tiene proveedores asociados." />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Código del proveedor</th>
                                <th>Precio del proveedor</th>
                                <th>Preferido</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in asociaciones)
                            {
                                <tr class="@(!a.Activo ? "opacity-60" : "")">
                                    <td class="font-medium text-heading">@a.Proveedor?.Nombre</td>
                                    <td><code class="text-xs bg-card-elevated px-1.5 py-0.5 rounded">@a.CodigoProveedor</code></td>
                                    <td>@(a.PrecioProveedor is not null ? a.PrecioProveedor.Value.ToString("C") : "-")</td>
                                    <td>
                                        @if (a.EsPreferido)
                                        {
                                            <Badge Variant="BadgeVariant.Success">★ Preferido</Badge>
                                        }
                                    </td>
                                    <td>
                                        @if (a.Activo)
                                        {
                                            <Badge Variant="BadgeVariant.Success">Activo</Badge>
                                        }
                                        else
                                        {
                                            <Badge Variant="BadgeVariant.Neutral">Inactivo</Badge>
                                        }
                                    </td>
                                    <td class="text-right">
                                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Icon="pencil" OnClick="() => EmpezarEdicion(a)">Editar</Button>

                                        @if (a.Activo)
                                        {
                                            <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="x-circle" OnClick="() => PedirConfirmacionDesactivar(a)">Desactivar</Button>
                                        }
                                        else
                                        {
                                            <Button Variant="ButtonVariant.Success" Size="ButtonSize.Small" Icon="check" OnClick="() => Reactivar(a)">Activar</Button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>

        <Card Title="@(editando ? "Editar asociación" : "Asociar un proveedor")">
            <EditForm Model="modelo" OnValidSubmit="GuardarAsociacion" FormName="asociar-proveedor">
                <FormField Label="Proveedor" Required="true">
                    <select class="form-select" @bind="modelo.ProveedorId" disabled="@(editando)">
                        <option value="0">Selecciona uno...</option>
                        @foreach (var p in proveedoresDisponibles)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                    @if (editando)
                    {
                        <p class="mt-1 text-xs text-muted">El proveedor no se puede cambiar al editar — si necesitas otro, desactiva la asociación y crea una nueva.</p>
                    }
                </FormField>

                <FormField Label="Código con el que ESE proveedor identifica este producto" Required="true" Hint="Es el SKU/referencia propio del proveedor, no el Id interno del catálogo.">
                    <InputText @bind-Value="modelo.CodigoProveedor" class="form-input" placeholder="p.ej. SKU-8827-A" />
                </FormField>

                <FormField Label="Precio del proveedor (opcional)">
                    <InputNumber @bind-Value="modelo.PrecioProveedor" class="form-input" />
                </FormField>

                <label class="flex items-center gap-2 text-sm text-body mb-4">
                    <InputCheckbox @bind-Value="modelo.EsPreferido" class="form-checkbox" />
                    Marcar como proveedor preferido
                </label>

                @if (!string.IsNullOrEmpty(error))
                {
                    <Alert Variant="AlertVariant.Danger">@error</Alert>
                }
                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <Alert Variant="AlertVariant.Success">@mensaje</Alert>
                }

                <div class="mt-4 flex items-center gap-2">
                    <Button Type="submit" Variant="ButtonVariant.Primary" Icon="@(editando ? "check" : "plus")">@(editando ? "Guardar cambios" : "Asociar proveedor")</Button>
                    @if (editando)
                    {
                        <Button Variant="ButtonVariant.Ghost" OnClick="CancelarEdicion">Cancelar</Button>
                    }
                </div>
            </EditForm>
        </Card>

        <p class="text-sm">
            <a href="/proveedores" class="text-primary-300 hover:underline">Ver todos los proveedores</a>
            <span class="text-muted/50 mx-2">·</span>
            <a href="/catalogo" class="text-primary-300 hover:underline">Volver al catálogo</a>
        </p>
    </div>
}

<ConfirmDialog @bind-Visible="confirmandoDesactivar" Title="Desactivar proveedor" Danger="true"
               Message="@($"¿Desactivar a \"{proveedorADesactivarNombre}\" de este producto? Dejará de recibir pedidos nuevos; los ya emitidos no se alteran.")"
               ConfirmText="Desactivar" OnConfirm="ConfirmarDesactivar" />

@code {
    [Parameter] public int ProductoId { get; set; }

    private Producto? producto;
    private List<ProductoProveedor>? asociaciones;
    private List<Proveedor> proveedoresDisponibles = new();
    private AsociarProveedorDto modelo = new();
    private string? error;
    private string? mensaje;

    private bool editando;
    private int asociacionEnEdicionId;

    private bool confirmandoDesactivar;
    private int asociacionADesactivarId;
    private string? proveedorADesactivarNombre;

    protected override async Task OnInitializedAsync()
    {
        modelo.ProductoId = ProductoId;
        producto = await ProductoService.ObtenerPorIdAsync(ProductoId);
        proveedoresDisponibles = await ProveedorService.ObtenerTodosAsync();
        await Cargar();

        HeaderState.Set("Proveedores del producto", [("Catálogo", "/catalogo"), (producto?.Nombre ?? "Producto", null), ("Proveedores", null)]);
    }

    private async Task Cargar()
    {
        asociaciones = await ProveedorService.ObtenerProveedoresDeProductoAsync(ProductoId);
    }

    private async Task GuardarAsociacion()
    {
        error = null;
        mensaje = null;

        if (modelo.ProveedorId == 0)
        {
            error = "Selecciona un proveedor.";
            return;
        }

        try
        {
            if (editando)
            {
                await ProveedorService.ActualizarAsociacionAsync(asociacionEnEdicionId, modelo);
                mensaje = "Asociación actualizada correctamente.";
            }
            else
            {
                await ProveedorService.AsociarProveedorAsync(modelo);
                mensaje = "Proveedor asociado correctamente.";
            }

            CancelarEdicion();
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private void EmpezarEdicion(ProductoProveedor a)
    {
        editando = true;
        asociacionEnEdicionId = a.Id;
        modelo = new AsociarProveedorDto
        {
            ProductoId = a.ProductoId,
            ProveedorId = a.ProveedorId,
            CodigoProveedor = a.CodigoProveedor,
            PrecioProveedor = a.PrecioProveedor,
            EsPreferido = a.EsPreferido
        };
        error = null;
        mensaje = null;
    }

    private void CancelarEdicion()
    {
        editando = false;
        asociacionEnEdicionId = 0;
        modelo = new AsociarProveedorDto { ProductoId = ProductoId };
    }

    private void PedirConfirmacionDesactivar(ProductoProveedor a)
    {
        asociacionADesactivarId = a.Id;
        proveedorADesactivarNombre = a.Proveedor?.Nombre;
        confirmandoDesactivar = true;
    }

    private async Task ConfirmarDesactivar()
    {
        await ProveedorService.DesactivarAsociacionAsync(asociacionADesactivarId);
        await Cargar();
    }

    private async Task Reactivar(ProductoProveedor a)
    {
        await ProveedorService.ReactivarAsociacionAsync(a.Id);
        await Cargar();
    }
}