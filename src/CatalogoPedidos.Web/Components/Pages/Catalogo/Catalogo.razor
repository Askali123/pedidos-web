@page "/catalogo"
@attribute [Authorize]
@inject IProductoService Productos
@inject IProveedorService Proveedores
@inject PageHeaderState HeaderState
@inject CarritoState Carrito
@implements IDisposable

<PageTitle>Catálogo</PageTitle>

<div class="space-y-4">
    <Card>
        <div class="flex flex-wrap items-center gap-3">
            <div class="relative flex-1 min-w-[220px]">
                <Icon Name="search" Class="h-4 w-4 text-muted absolute left-3 top-1/2 -translate-y-1/2" />
                <input type="text" class="form-input pl-9" placeholder="Buscar por nombre o descripción..."
                       @bind="texto" @bind:event="oninput" @onkeyup="Filtrar" />
            </div>

            <select class="form-select w-auto" @bind="categoria" @bind:after="Filtrar">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c">@c</option>
                }
            </select>

            <AuthorizeView Roles="@Roles.Gestor" Context="proveedorFiltroContext">
                <Authorized>
                    <select class="form-select w-auto" @bind="proveedorIdTexto" @bind:after="Filtrar">
                        <option value="">Todos los proveedores</option>
                        @foreach (var prov in proveedores)
                        {
                            <option value="@prov.Id">@prov.Nombre</option>
                        }
                    </select>
                </Authorized>
            </AuthorizeView>

            <a class="btn btn-secondary" href="@UrlExportarPdf" target="_blank">
                <Icon Name="download" Class="h-4 w-4" /> Exportar a PDF
            </a>

            <AuthorizeView Roles="@Roles.Gestor" Context="mostrarInactivosContext">
                <Authorized>
                    <label class="flex items-center gap-2 text-sm text-body"
                           title="@(proveedorId is not null ? "No aplica al filtrar por proveedor" : null)">
                        <input type="checkbox" class="form-checkbox" @bind="mostrarInactivos" @bind:after="Filtrar"
                               disabled="@(proveedorId is not null)" />
                        Mostrar desactivados
                    </label>
                </Authorized>
            </AuthorizeView>
        </div>
    </Card>

    @if (filas is null)
    {
        <Loading />
    }
    else if (filas.Count == 0)
    {
        <div class="card"><EmptyState Icon="cube" Title="Sin resultados" Description="No hay productos que coincidan con la búsqueda." /></div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table-enterprise">
                <thead>
                    <tr>
                        @if (proveedorId is not null)
                        {
                            <th>Código interno</th>
                            <th>Código proveedor</th>
                        }
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Descripción</th>
                        <th>Unidad</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in paginaActual)
                    {
                        var p = fila.Producto;
                        <tr class="@(!p.Activo ? "opacity-60" : "")">
                            @if (proveedorId is not null)
                            {
                                <td class="text-muted" data-label="Código interno">#@p.Id</td>
                                <td class="font-medium text-heading" data-label="Código proveedor">@fila.CodigoProveedor</td>
                            }
                            <td class="font-medium text-heading" data-label="Nombre">
                                @p.Nombre
                                @if (!p.Activo)
                                {
                                    <Badge Variant="BadgeVariant.Warning">Desactivado</Badge>
                                }
                            </td>
                            <td data-label="Categoría"><Badge Variant="BadgeVariant.Neutral">@p.Categoria</Badge></td>
                            <td class="text-muted" data-label="Descripción">@p.Descripcion</td>
                            <td class="text-muted" data-label="Unidad">@p.UnidadMedida</td>
                            <td data-label="Precio">@(p.Precio > 0 ? p.Precio.ToString("C") : "Sin precio")</td>
                            <td data-label="Stock">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="@(p.Stock < 0 ? "text-danger-400 font-medium" : "")"
                                          title="@(p.Stock < 0 ? "Stock negativo: se aprobaron más solicitudes que el stock disponible" : null)">@p.Stock</span>
                                    @if (p.StockMinimo is not null && p.Stock <= p.StockMinimo)
                                    {
                                        <span title="@($"Por debajo del mínimo configurado ({p.StockMinimo})")">
                                            <Badge Variant="BadgeVariant.Danger">⚠ Bajo</Badge>
                                        </span>
                                    }
                                    <AuthorizeView Roles="@Roles.Gestor" Context="stockContext">
                                        <Authorized>
                                            <button type="button" class="text-muted hover:text-body" title="Configurar alerta de stock" @onclick="() => AbrirConfigStock(p)">
                                                <Icon Name="pencil" Class="h-3.5 w-3.5" />
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                            <td>
                                <div class="flex items-center gap-2 justify-end flex-wrap">
                                    <AuthorizeView Roles="@Roles.Gestor" Context="carritoContext">
                                        <NotAuthorized>
                                            @if (Carrito.Contiene(p.Id))
                                            {
                                                <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="check" OnClick="() => AgregarAlCarrito(p)">En el carrito</Button>
                                            }
                                            else
                                            {
                                                <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small" Icon="cart" OnClick="() => AgregarAlCarrito(p)">Agregar</Button>
                                            }
                                        </NotAuthorized>
                                    </AuthorizeView>
                                    <AuthorizeView Roles="@Roles.Gestor" Context="gestorContext">
                                        <Authorized>
                                            <a class="btn btn-secondary btn-sm" href="/catalogo/@p.Id/editar">Editar</a>
                                            <a class="btn btn-secondary btn-sm" href="/catalogo/@p.Id/proveedores">Proveedores</a>
                                            @if (p.Activo)
                                            {
                                                <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Icon="trash" OnClick="() => PedirConfirmacionDesactivar(p)">Desactivar</Button>
                                            }
                                            else
                                            {
                                                <Button Variant="ButtonVariant.Success" Size="ButtonSize.Small" Icon="check" OnClick="() => Reactivar(p)">Reactivar</Button>
                                            }
                                        </Authorized>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pagination CurrentPage="paginaNumero" TotalPages="totalPaginas" CurrentPageChanged="p => paginaNumero = p" />
        </div>
    }
</div>

<Modal Visible="modalStockVisible" VisibleChanged="v => modalStockVisible = v" Title="Configurar alerta de stock">
    <ChildContent>
        @if (productoEditando is not null)
        {
            <p class="text-sm text-body mb-3">@productoEditando.Nombre</p>
            <FormField Label="Stock mínimo (opcional)" Hint="Si el stock queda en o por debajo de este número al aprobar una solicitud, se te avisa. Déjalo vacío para no recibir alertas de este producto.">
                <InputNumber @bind-Value="stockMinimoEditado" class="form-input" placeholder="p.ej. 5" />
            </FormField>
        }
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Ghost" OnClick="() => modalStockVisible = false">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Icon="check" OnClick="GuardarStockMinimo">Guardar</Button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Visible="confirmandoDesactivar" Title="Desactivar producto" Danger="true"
               Message="@($"¿Desactivar \"{productoADesactivarNombre}\"? Dejará de verse en el catálogo y de poder solicitarse; su historial de solicitudes se conserva.")"
               ConfirmText="Desactivar" OnConfirm="ConfirmarDesactivar" />

@code {
    private const int TamanoPagina = 8;

    /// <summary>
    /// Fila unificada para la tabla: viene del catálogo general (sin código de proveedor)
    /// o de la vista filtrada por proveedor (con su código y, si no tiene precio propio
    /// cargado, el precio general del producto).
    /// </summary>
    private sealed class FilaCatalogo
    {
        public required Producto Producto { get; init; }
        public string? CodigoProveedor { get; init; }
    }

    private List<FilaCatalogo>? filas;
    private List<string> categorias = new();
    private List<Proveedor> proveedores = new();
    private string texto = "";
    private string categoria = "";
    private string proveedorIdTexto = "";
    private bool mostrarInactivos;
    private int paginaNumero = 1;

    private int? proveedorId => int.TryParse(proveedorIdTexto, out var id) ? id : null;

    private int totalPaginas => filas is null ? 1 : Math.Max(1, (int)Math.Ceiling(filas.Count / (double)TamanoPagina));
    private IEnumerable<FilaCatalogo> paginaActual => (filas ?? []).Skip((paginaNumero - 1) * TamanoPagina).Take(TamanoPagina);

    private string UrlExportarPdf
    {
        get
        {
            var query = new List<string> { "" };
            if (!string.IsNullOrWhiteSpace(texto)) query.Add($"texto={Uri.EscapeDataString(texto)}");
            if (!string.IsNullOrWhiteSpace(categoria)) query.Add($"categoria={Uri.EscapeDataString(categoria)}");
            if (proveedorId is int id) query.Add($"proveedorId={id}");
            return "/api/catalogo/pdf?" + string.Join("&", query.Skip(1));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Catálogo");
        Carrito.Changed += Refrescar;
        categorias = await Productos.ObtenerCategoriasAsync();
        proveedores = await Proveedores.ObtenerTodosAsync();
        await Filtrar();
    }

    private async Task Filtrar()
    {
        var textoFiltro = string.IsNullOrEmpty(texto) ? null : texto;
        var categoriaFiltro = string.IsNullOrEmpty(categoria) ? null : categoria;

        if (proveedorId is int id)
        {
            var asociaciones = await Proveedores.ObtenerProductosDeProveedorAsync(id, textoFiltro, categoriaFiltro, soloActivos: true);
            filas = asociaciones
                .Where(a => a.Producto is not null)
                .Select(a => new FilaCatalogo { Producto = a.Producto!, CodigoProveedor = a.CodigoProveedor })
                .ToList();
        }
        else
        {
            // El toggle "Mostrar desactivados" no aplica al filtrar por proveedor: esa rama
            // usa ObtenerProductosDeProveedorAsync(soloActivos: true), que ya es otra
            // consulta (sobre la asociación, no sobre el producto) — se deshabilita el
            // checkbox en el markup para que no quede la sensación de que hace algo.
            var catalogo = await Productos.ObtenerCatalogoAsync(textoFiltro, categoriaFiltro, incluirInactivos: mostrarInactivos);
            filas = catalogo.Select(p => new FilaCatalogo { Producto = p }).ToList();
        }

        paginaNumero = 1;
    }

    private void AgregarAlCarrito(Producto producto) => Carrito.Agregar(producto);

    private bool modalStockVisible;
    private Producto? productoEditando;
    private int? stockMinimoEditado;

    private void AbrirConfigStock(Producto producto)
    {
        productoEditando = producto;
        stockMinimoEditado = producto.StockMinimo;
        modalStockVisible = true;
    }

    private async Task GuardarStockMinimo()
    {
        if (productoEditando is null)
            return;

        await Productos.ActualizarStockMinimoAsync(productoEditando.Id, stockMinimoEditado);
        productoEditando.StockMinimo = stockMinimoEditado;
        modalStockVisible = false;
    }

    private bool confirmandoDesactivar;
    private int productoADesactivarId;
    private string? productoADesactivarNombre;

    private void PedirConfirmacionDesactivar(Producto producto)
    {
        productoADesactivarId = producto.Id;
        productoADesactivarNombre = producto.Nombre;
        confirmandoDesactivar = true;
    }

    private async Task ConfirmarDesactivar()
    {
        await Productos.DesactivarAsync(productoADesactivarId);
        await Filtrar();
    }

    private async Task Reactivar(Producto producto)
    {
        await Productos.ReactivarAsync(producto.Id);
        await Filtrar();
    }

    private void Refrescar() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Carrito.Changed -= Refrescar;
    }
}
