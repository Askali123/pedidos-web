@page "/catalogo/nuevo"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IProductoService Productos
@inject IProveedorService Proveedores
@inject NavigationManager Navigation
@inject PageHeaderState HeaderState

<PageTitle>Nuevo producto</PageTitle>

<div class="max-w-xl">
    <Card Title="Capturar nuevo producto" Subtitle="Alta manual al catálogo">
        <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="nuevo-producto">
            <DataAnnotationsValidator />

            <FormField Label="Nombre" Required="true">
                <InputText @bind-Value="modelo.Nombre" class="form-input" />
            </FormField>

            <div class="grid grid-cols-2 gap-4">
                <FormField Label="Categoría">
                    <InputText @bind-Value="modelo.Categoria" class="form-input" />
                </FormField>

                <FormField Label="Unidad de medida">
                    <InputText @bind-Value="modelo.UnidadMedida" class="form-input" placeholder="UNIDAD, GALON, PAQUETE..." />
                </FormField>
            </div>

            <FormField Label="Descripción">
                <InputTextArea @bind-Value="modelo.Descripcion" class="form-textarea" rows="3" />
            </FormField>

            <div class="grid grid-cols-2 gap-4">
                <FormField Label="Precio">
                    <InputNumber @bind-Value="modelo.Precio" class="form-input" />
                </FormField>

                <FormField Label="Stock">
                    <InputNumber @bind-Value="modelo.Stock" class="form-input" />
                </FormField>
            </div>

            <FormField Label="Stock mínimo (opcional)" Hint="Si el stock queda en o por debajo de este número al aprobar una solicitud, se le avisa al gestor. Déjalo vacío para no recibir alertas de este producto.">
                <InputNumber @bind-Value="modelo.StockMinimo" class="form-input" placeholder="p.ej. 5" />
            </FormField>

            <div class="grid grid-cols-2 gap-4 mt-2 pt-4 border-t border-gray-100">
                <FormField Label="Proveedor (opcional)">
                    <select class="form-select" @bind="proveedorId">
                        <option value="0">Sin proveedor por ahora</option>
                        @foreach (var p in proveedoresDisponibles)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                </FormField>

                <FormField Label="Código de ese proveedor" Required="@(proveedorId != 0)" Hint="El SKU/referencia con el que ÉL identifica este producto, no el Id interno.">
                    <InputText @bind-Value="modelo.CodigoProveedor" class="form-input" placeholder="p.ej. 1281" disabled="@(proveedorId == 0)" />
                </FormField>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <Alert Variant="AlertVariant.Danger">@error</Alert>
            }
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <Alert Variant="AlertVariant.Success">@mensaje</Alert>
            }

            <div class="mt-2">
                <Button Type="submit" Variant="ButtonVariant.Primary" Icon="check">Guardar producto</Button>
            </div>
        </EditForm>
    </Card>
</div>

@code {
    private CrearProductoDto modelo = new();
    private List<Proveedor> proveedoresDisponibles = new();
    private int proveedorId;
    private string? mensaje;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Nuevo producto", [("Catálogo", "/catalogo"), ("Nuevo producto", null)]);
        proveedoresDisponibles = await Proveedores.ObtenerTodosAsync();
    }

    private async Task Guardar()
    {
        error = null;
        mensaje = null;

        modelo.ProveedorId = proveedorId == 0 ? null : proveedorId;

        try
        {
            await Productos.CrearAsync(modelo);
            mensaje = $"Producto '{modelo.Nombre}' guardado correctamente.";
            modelo = new();
            proveedorId = 0;
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }
}
