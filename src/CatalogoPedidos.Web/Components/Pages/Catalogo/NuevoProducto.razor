@page "/catalogo/nuevo"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IProductoService Productos
@inject NavigationManager Navigation

<PageTitle>Nuevo producto</PageTitle>

<h1>Capturar nuevo producto</h1>

<EditForm Model="modelo" OnValidSubmit="Guardar" FormName="nuevo-producto">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="campo">
        <label>Nombre</label>
        <InputText @bind-Value="modelo.Nombre" />
    </div>

    <div class="campo">
        <label>Categoría</label>
        <InputText @bind-Value="modelo.Categoria" />
    </div>

    <div class="campo">
        <label>Descripción</label>
        <InputTextArea @bind-Value="modelo.Descripcion" />
    </div>

    <div class="campo">
        <label>Precio</label>
        <InputNumber @bind-Value="modelo.Precio" />
    </div>

    <div class="campo">
        <label>Stock</label>
        <InputNumber @bind-Value="modelo.Stock" />
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="mensaje">@mensaje</p>
    }

    <button type="submit" class="btn">Guardar producto</button>
</EditForm>

<style>
    .campo { margin-bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.25rem; max-width: 400px; }
    .btn { padding: 0.5rem 1rem; background: #1b1f27; color: white; border: none; border-radius: 4px; cursor: pointer; }
    .mensaje { color: green; }
</style>

@code {
    private CrearProductoDto modelo = new();
    private string? mensaje;

    private async Task Guardar()
    {
        await Productos.CrearAsync(modelo);
        mensaje = $"Producto '{modelo.Nombre}' guardado correctamente.";
        modelo = new();
    }
}
