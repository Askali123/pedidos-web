@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="max-w-2xl mx-auto">
    <Card Title="Ocurrió un error" Subtitle="Hubo un problema al procesar la solicitud.">
        <Alert Variant="AlertVariant.Danger">
            Algo salió mal de nuestro lado. Si el problema persiste, contactá al administrador del sistema.
        </Alert>

        @if (ShowRequestId)
        {
            <p class="text-sm text-muted mt-4">
                <strong class="text-body">ID de solicitud:</strong> <code class="text-xs bg-card-elevated px-1.5 py-0.5 rounded">@RequestId</code>
            </p>
        }

        <div class="mt-4">
            <a href="/" class="btn btn-secondary btn-sm">Volver al inicio</a>
        </div>
    </Card>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
