@page "/proveedores"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IProveedorService ProveedorService
@inject PageHeaderState HeaderState

<PageTitle>Proveedores</PageTitle>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2">
        <Card Title="Proveedores registrados">
            @if (proveedores is null)
            {
                <Loading />
            }
            else if (proveedores.Count == 0)
            {
                <EmptyState Icon="truck" Title="Sin proveedores" Description="Todavía no hay proveedores registrados." />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table-enterprise">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>NIT</th>
                                <th>Contacto</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in proveedores)
                            {
                                <tr>
                                    <td class="font-medium text-gray-900">@p.Nombre</td>
                                    <td>@p.Nit</td>
                                    <td>@p.Contacto</td>
                                    <td>@p.Telefono</td>
                                    <td>@p.Email</td>
                                    <td class="text-right">
                                        <a class="btn btn-secondary btn-sm" href="/proveedores/@p.Id/productos">Ver productos</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>
    </div>

    <Card Title="Nuevo proveedor">
        <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="nuevo-proveedor">
            <DataAnnotationsValidator />

            <FormField Label="Nombre" Required="true">
                <InputText @bind-Value="modelo.Nombre" class="form-input" />
            </FormField>

            <FormField Label="NIT">
                <InputText @bind-Value="modelo.Nit" class="form-input" />
            </FormField>

            <FormField Label="Contacto">
                <InputText @bind-Value="modelo.Contacto" class="form-input" />
            </FormField>

            <FormField Label="Teléfono">
                <InputText @bind-Value="modelo.Telefono" class="form-input" />
            </FormField>

            <FormField Label="Email">
                <InputText @bind-Value="modelo.Email" class="form-input" />
            </FormField>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <Alert Variant="AlertVariant.Success">@mensaje</Alert>
            }

            <div class="mt-2">
                <Button Type="submit" Variant="ButtonVariant.Primary" Icon="plus">Guardar proveedor</Button>
            </div>
        </EditForm>
    </Card>
</div>

@code {
    private List<Proveedor>? proveedores;
    private CrearProveedorDto modelo = new();
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Proveedores", [("Proveedores", null)]);
        await Cargar();
    }

    private async Task Cargar()
    {
        proveedores = await ProveedorService.ObtenerTodosAsync();
    }

    private async Task Guardar()
    {
        await ProveedorService.CrearAsync(modelo);
        mensaje = $"Proveedor '{modelo.Nombre}' guardado correctamente.";
        modelo = new();
        await Cargar();
    }
}
