@page "/empresas"
@attribute [Authorize(Roles = Roles.Gestor)]
@inject IEmpresaService EmpresaService
@inject ISedeService SedeService
@inject IUsuarioSedeDirectory UsuarioSedeDirectory
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Empresas</PageTitle>

<div class="space-y-6">
    <Card Title="Empresas filiales de Auropaq">
        @if (empresas is null)
        {
            <Loading />
        }
        else if (empresas.Count == 0)
        {
            <EmptyState Icon="building-store" Title="Sin empresas" Description="Todavía no hay empresas filiales registradas." />
        }
        else
        {
            <div class="table-wrap">
                <table class="table-enterprise">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>NIT</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in empresas)
                        {
                            <tr>
                                <td class="font-medium text-heading" data-label="Nombre">@e.Nombre</td>
                                <td data-label="NIT">@e.Nit</td>
                                <td class="text-right">
                                    <div class="flex items-center gap-2 justify-end flex-wrap">
                                        <a class="btn btn-secondary btn-sm" href="/sedes?empresaId=@e.Id">Ver sedes</a>
                                        <Button Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Icon="pencil" OnClick="() => AbrirEditar(e)">Editar</Button>
                                        <Button Variant="ButtonVariant.DangerSubtle" Size="ButtonSize.Small" Icon="trash" OnClick="() => PedirConfirmacionDesactivar(e)">Desactivar</Button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Card>

    <div class="max-w-xl">
        <Card Title="Nueva empresa">
            <EditForm Model="modelo" OnValidSubmit="Guardar" FormName="nueva-empresa">
                <DataAnnotationsValidator />

                <FormField Label="Nombre" Required="true">
                    <InputText @bind-Value="modelo.Nombre" class="form-input" />
                </FormField>

                <FormField Label="NIT">
                    <InputText @bind-Value="modelo.Nit" class="form-input" />
                </FormField>

                @if (!string.IsNullOrEmpty(error))
                {
                    <Alert Variant="AlertVariant.Danger">@error</Alert>
                }
                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <Alert Variant="AlertVariant.Success">@mensaje</Alert>
                }

                <div class="mt-2">
                    <Button Type="submit" Variant="ButtonVariant.Primary" Icon="plus">Guardar empresa</Button>
                </div>
            </EditForm>
        </Card>
    </div>
</div>

<Modal Visible="modalEditarVisible" VisibleChanged="v => modalEditarVisible = v" Title="Editar empresa">
    <ChildContent>
        <EditForm Model="modeloEditar" OnValidSubmit="GuardarEdicion" FormName="editar-empresa">
            <DataAnnotationsValidator />

            <FormField Label="Nombre" Required="true">
                <InputText @bind-Value="modeloEditar.Nombre" class="form-input" />
            </FormField>

            <FormField Label="NIT">
                <InputText @bind-Value="modeloEditar.Nit" class="form-input" />
            </FormField>

            @if (!string.IsNullOrEmpty(errorEditar))
            {
                <Alert Variant="AlertVariant.Danger">@errorEditar</Alert>
            }

            <button type="submit" class="hidden" aria-hidden="true"></button>
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Ghost" OnClick="() => modalEditarVisible = false">Cancelar</Button>
        <Button Variant="ButtonVariant.Primary" Icon="check" OnClick="GuardarEdicion">Guardar</Button>
    </Footer>
</Modal>

<ConfirmDialog @bind-Visible="confirmandoDesactivar" Title="Desactivar empresa" Danger="true"
               Message="@MensajeConfirmacionDesactivar()"
               ConfirmText="Desactivar" OnConfirm="ConfirmarDesactivar" />

@code {
    private List<Empresa>? empresas;
    private CrearEmpresaDto modelo = new();
    private string? mensaje;
    private string? error;

    private bool modalEditarVisible;
    private int empresaEditandoId;
    private CrearEmpresaDto modeloEditar = new();
    private string? errorEditar;

    private bool confirmandoDesactivar;
    private int empresaADesactivarId;
    private string? empresaADesactivarNombre;
    private int sedesAfectadasDesactivar;
    private int usuariosAfectadosDesactivar;

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Empresas");
        await Cargar();
    }

    private async Task Cargar()
    {
        empresas = await EmpresaService.ObtenerTodasAsync();
    }

    private async Task Guardar()
    {
        error = null;
        mensaje = null;
        try
        {
            await EmpresaService.CrearAsync(modelo);
            mensaje = $"Empresa '{modelo.Nombre}' guardada correctamente.";
            modelo = new();
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            error = ex.Message;
        }
    }

    private void AbrirEditar(Empresa empresa)
    {
        empresaEditandoId = empresa.Id;
        modeloEditar = new CrearEmpresaDto
        {
            Nombre = empresa.Nombre,
            Nit = empresa.Nit
        };
        errorEditar = null;
        modalEditarVisible = true;
    }

    private async Task GuardarEdicion()
    {
        errorEditar = null;
        try
        {
            await EmpresaService.ActualizarAsync(empresaEditandoId, modeloEditar);
            modalEditarVisible = false;
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            errorEditar = ex.Message;
        }
    }

    private async Task PedirConfirmacionDesactivar(Empresa empresa)
    {
        empresaADesactivarId = empresa.Id;
        empresaADesactivarNombre = empresa.Nombre;

        // Desactivar una Empresa cascadea a sus Sedes activas (ver EmpresaService), así
        // que el aviso debe contar ambos niveles, no solo usuarios directos de la Empresa.
        sedesAfectadasDesactivar = (await SedeService.ObtenerTodasAsync(empresa.Id)).Count;

        // Scope aparte: IUsuarioSedeDirectory usa UserManager por dentro, que comparte el
        // AppDbContext Scoped de Identity — mismo criterio que GestionRoles.razor.
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedDirectory = scope.ServiceProvider.GetRequiredService<IUsuarioSedeDirectory>();
        usuariosAfectadosDesactivar = await scopedDirectory.ContarUsuariosPorEmpresaAsync(empresa.Id);

        confirmandoDesactivar = true;
    }

    private async Task ConfirmarDesactivar()
    {
        await EmpresaService.DesactivarAsync(empresaADesactivarId);
        await Cargar();
    }

    private string MensajeConfirmacionDesactivar()
    {
        var baseMsg = $"¿Desactivar \"{empresaADesactivarNombre}\"? Dejará de aparecer para asociar sedes/usuarios nuevos; sus sedes e histórico se conservan.";
        if (sedesAfectadasDesactivar == 0)
            return baseMsg;

        var avisoSedes = $"Esta empresa tiene {sedesAfectadasDesactivar} sede(s) activa(s) que también quedarán desactivadas";
        var avisoUsuarios = usuariosAfectadosDesactivar > 0
            ? $", con {usuariosAfectadosDesactivar} usuario(s) asociado(s) que quedarán sin sede activa hasta que los reasignes desde Gestión de roles."
            : ".";
        return $"{baseMsg} {avisoSedes}{avisoUsuarios}";
    }
}
