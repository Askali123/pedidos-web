@page "/usuarios/roles"
@attribute [Authorize(Roles = Roles.Gestor)]
@using System.Security.Claims
@using CatalogoPedidos.Application.Usuarios
@inject IUsuarioRolService UsuarioRolService
@inject ISedeService SedeService
@inject IServiceScopeFactory ScopeFactory
@inject PageHeaderState HeaderState

<PageTitle>Gestión de roles</PageTitle>

<div class="space-y-4">
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <Alert Variant="mensajeVariante" Dismissible="true" OnDismiss="() => mensaje = null">@mensaje</Alert>
    }

    @if (usuarios is null)
    {
        <div class="card"><Loading /></div>
    }
    else
    {
        <p class="text-sm text-muted">@usuarios.Count usuario(s) · @cantidadGestores gestor(es)</p>

        <div class="card table-wrap">
            <table class="table-enterprise">
                <thead>
                    <tr>
                        <th>Usuario</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Sede (empresa filial)</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in usuarios)
                    {
                        <tr>
                            <td class="font-medium text-heading">
                                @u.NombreCompleto
                                @if (u.Id == currentUserId)
                                {
                                    <span class="text-xs text-muted"> (vos)</span>
                                }
                            </td>
                            <td class="text-muted">@u.Email</td>
                            <td>
                                @if (u.EsGestor)
                                {
                                    <Badge Variant="BadgeVariant.Success">Gestor</Badge>
                                }
                                else
                                {
                                    <Badge Variant="BadgeVariant.Neutral">Solicitante</Badge>
                                }
                            </td>
                            <td>
                                <div class="flex items-center gap-2">
                                    <select class="form-select w-auto" value="@(u.SedeId?.ToString() ?? "")" @onchange="e => AsociarSede(u, e.Value?.ToString())">
                                        <option value="">Sin sede</option>
                                        @if (EsSedeInactiva(u))
                                        {
                                            <option value="@u.SedeId">@u.SedeNombre — inactiva</option>
                                        }
                                        @foreach (var grupo in sedesPorEmpresa)
                                        {
                                            <optgroup label="@grupo.Key">
                                                @foreach (var s in grupo)
                                                {
                                                    <option value="@s.Id">@s.Nombre</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                    @if (EsSedeInactiva(u))
                                    {
                                        <span class="text-xs text-warning-700" title="La sede de este usuario está desactivada — conviene reasignarlo.">⚠ sede inactiva</span>
                                    }
                                </div>
                            </td>
                            <td class="text-right">
                                @if (u.EsGestor)
                                {
                                    <Button Variant="ButtonVariant.Danger" Size="ButtonSize.Small" Disabled="cantidadGestores <= 1" OnClick="() => QuitarGestor(u)">Quitar gestor</Button>
                                }
                                else
                                {
                                    <Button Variant="ButtonVariant.Primary" Size="ButtonSize.Small" OnClick="() => AsignarGestor(u)">Hacer gestor</Button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private List<UsuarioRolDto>? usuarios;
    private List<IGrouping<string, Sede>> sedesPorEmpresa = [];
    private HashSet<int> sedesActivasIds = [];
    private string? currentUserId;
    private string? mensaje;
    private AlertVariant mensajeVariante = AlertVariant.Success;

    private int cantidadGestores => usuarios?.Count(u => u.EsGestor) ?? 0;

    /// <summary>
    /// True cuando la sede del usuario ya no está entre las activas — pasa cuando se
    /// desactivó después de asociarlo (ver docs/PLAN_EMPRESAS_FILIALES.md, Etapa 9). Sin
    /// esto, el <select> no tendría ningún <option> que calce con su valor real y
    /// aparentaría (falsamente) que el usuario no tiene sede.
    /// </summary>
    private bool EsSedeInactiva(UsuarioRolDto u) => u.SedeId is not null && !sedesActivasIds.Contains(u.SedeId.Value);

    protected override async Task OnInitializedAsync()
    {
        HeaderState.Set("Gestión de roles");

        var authState = await AuthStateTask!;
        currentUserId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        // Ya vienen ordenadas por Empresa.Nombre y luego Sede.Nombre (ver
        // SedeRepository.ObtenerTodasAsync) — GroupBy conserva ese orden.
        var sedes = await SedeService.ObtenerTodasAsync();
        sedesPorEmpresa = sedes.GroupBy(s => s.Empresa?.Nombre ?? "Sin empresa").ToList();
        sedesActivasIds = sedes.Select(s => s.Id).ToHashSet();

        await Cargar();
    }

    private async Task Cargar()
    {
        // Scope aparte para IUsuarioRolService: por dentro usa UserManager, que comparte
        // el AppDbContext Scoped de Identity con UserMenu.razor — mismo criterio que el
        // resto de "Administrar cuenta" (ver docs/PLAN_MEJORAS_AUTENTICACION.md #2).
        await using var scope = ScopeFactory.CreateAsyncScope();
        var scopedService = scope.ServiceProvider.GetRequiredService<IUsuarioRolService>();
        usuarios = await scopedService.ObtenerUsuariosAsync();
    }

    private async Task AsignarGestor(UsuarioRolDto usuario)
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var scopedService = scope.ServiceProvider.GetRequiredService<IUsuarioRolService>();
            await scopedService.AsignarGestorAsync(usuario.Id);

            mensaje = $"{usuario.NombreCompleto} ahora es Gestor.";
            mensajeVariante = AlertVariant.Success;
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            mensaje = $"Error: {ex.Message}";
            mensajeVariante = AlertVariant.Warning;
        }
    }

    private async Task QuitarGestor(UsuarioRolDto usuario)
    {
        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var scopedService = scope.ServiceProvider.GetRequiredService<IUsuarioRolService>();
            await scopedService.QuitarGestorAsync(usuario.Id);

            // El cookie de sesión de ESTA pestaña no se puede reescribir desde un click
            // handler interactivo (ya se mandó la respuesta HTTP inicial) — a diferencia
            // de ChangePassword.razor, que sí puede porque corre dentro de un form POST.
            // Si te quitaste el rol a vos mismo, avisar que hace falta volver a entrar.
            mensaje = usuario.Id == currentUserId
                ? "Te quitaste el rol Gestor. Cerrá sesión y volvé a entrar para que se refleje."
                : $"Se le quitó el rol Gestor a {usuario.NombreCompleto}.";
            mensajeVariante = AlertVariant.Success;
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            mensaje = $"Error: {ex.Message}";
            mensajeVariante = AlertVariant.Warning;
        }
    }

    private async Task AsociarSede(UsuarioRolDto usuario, string? valorSeleccionado)
    {
        int? sedeId = string.IsNullOrEmpty(valorSeleccionado) ? null : int.Parse(valorSeleccionado);

        try
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            var scopedService = scope.ServiceProvider.GetRequiredService<IUsuarioRolService>();
            await scopedService.AsociarSedeAsync(usuario.Id, sedeId);

            var sedeNombre = sedesPorEmpresa.SelectMany(g => g).FirstOrDefault(s => s.Id == sedeId)?.Nombre;
            mensaje = sedeId is null
                ? $"Se le quitó la sede a {usuario.NombreCompleto}."
                : $"{usuario.NombreCompleto} quedó asociado a {sedeNombre}.";
            mensajeVariante = AlertVariant.Success;
            await Cargar();
        }
        catch (InvalidOperationException ex)
        {
            mensaje = $"Error: {ex.Message}";
            mensajeVariante = AlertVariant.Warning;
            // El <select> ya cambió visualmente por el binding manual (value="@u.SedeId") —
            // recargar deja la UI fiel al estado real si la asociación falló.
            await Cargar();
        }
    }
}
