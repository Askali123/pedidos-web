@* Ruta de navegación en el Topbar. Items = lista de (Texto, Url opcional). *@
<nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-muted">
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        var isLast = i == Items.Count - 1;

        if (!string.IsNullOrEmpty(item.Url) && !isLast)
        {
            <a href="@item.Url" class="hover:text-body">@item.Text</a>
        }
        else
        {
            <span class="@(isLast ? "text-heading font-medium" : "")">@item.Text</span>
        }

        if (!isLast)
        {
            <Icon Name="chevron-right" Class="h-3.5 w-3.5 text-muted/50" />
        }
    }
</nav>

@code {
    [Parameter] public List<(string Text, string? Url)> Items { get; set; } = new();
}
