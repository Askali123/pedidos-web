@* Cabecera de pestañas. El contenido de cada pestaña lo decide el padre según ActiveIndex. *@
<div class="border-b border-gray-200">
    <nav class="flex gap-6 -mb-px">
        @for (var i = 0; i < Labels.Count; i++)
        {
            var index = i;
            var active = index == ActiveIndex;
            <button type="button"
                    class="@("py-3 text-sm font-medium border-b-2 transition-colors " + (active ? "border-primary-600 text-primary-700" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300"))"
                    @onclick="() => Seleccionar(index)">
                @Labels[index]
            </button>
        }
    </nav>
</div>

@code {
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    private async Task Seleccionar(int index)
    {
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }
}
