@* Estado vacío estándar — usar en vez de un simple <p>No hay datos</p>. *@
<div class="flex flex-col items-center justify-center text-center py-12 px-4">
    <div class="h-12 w-12 rounded-full bg-gray-100 flex items-center justify-center text-gray-400 mb-3">
        <Icon Name="@Icon" Class="h-6 w-6" />
    </div>
    <h3 class="text-gray-900">@Title</h3>
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="text-sm text-gray-500 mt-1 max-w-sm">@Description</p>
    }
    @if (Action is not null)
    {
        <div class="mt-4">@Action</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "inbox";
    [Parameter] public string Title { get; set; } = "Sin datos";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
}
