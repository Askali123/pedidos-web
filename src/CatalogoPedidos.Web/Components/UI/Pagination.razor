@* Paginación estándar para tablas. *@
@if (TotalPages > 1)
{
    <div class="flex items-center justify-between px-4 py-3 border-t border-border-subtle">
        <p class="text-xs text-muted">Página @CurrentPage de @TotalPages</p>
        <div class="flex items-center gap-1">
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurrentPage <= 1)" @onclick="() => Ir(CurrentPage - 1)">
                <Icon Name="chevron-left" Class="h-4 w-4" />
            </button>
            @foreach (var numeroPagina in PaginasVisibles())
            {
                @if (numeroPagina is null)
                {
                    <span class="h-8 w-8 flex items-center justify-center text-sm text-muted">…</span>
                }
                else
                {
                    <button type="button"
                            class="@("h-8 w-8 rounded-sm text-sm font-medium " + (numeroPagina == CurrentPage ? "bg-primary-600 text-white" : "text-body hover:bg-card-elevated"))"
                            @onclick="() => Ir(numeroPagina.Value)">
                        @numeroPagina
                    </button>
                }
            }
            <button type="button" class="btn btn-ghost btn-sm" disabled="@(CurrentPage >= TotalPages)" @onclick="() => Ir(CurrentPage + 1)">
                <Icon Name="chevron-right" Class="h-4 w-4" />
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> CurrentPageChanged { get; set; }

    private async Task Ir(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return;
        CurrentPage = page;
        await CurrentPageChanged.InvokeAsync(page);
    }

    // Paginación con ventana: primera y última página siempre visibles, más un par
    // de vecinas alrededor de la actual; el resto se resume con "…" en vez de listar
    // un botón por página. Con 7 páginas o menos se listan todas (nunca hay hueco que
    // resumir). null = "…" — ver docs/PLAN_MEJORAS_UI_UX.md #3.
    private List<int?> PaginasVisibles()
    {
        var paginas = new List<int?>();

        if (TotalPages <= 7)
        {
            for (var p = 1; p <= TotalPages; p++)
                paginas.Add(p);
            return paginas;
        }

        paginas.Add(1);

        var desde = Math.Max(2, CurrentPage - 1);
        var hasta = Math.Min(TotalPages - 1, CurrentPage + 1);

        if (desde > 2)
            paginas.Add(null);

        for (var p = desde; p <= hasta; p++)
            paginas.Add(p);

        if (hasta < TotalPages - 1)
            paginas.Add(null);

        paginas.Add(TotalPages);
        return paginas;
    }
}
